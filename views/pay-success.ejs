<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Оплата прошла — Wayfis</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: #0E0F10; color: #fff;
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
    }
    <% var accentHex = (typeof settings !== 'undefined' && settings.theme_accent) || '#10B981'; var _r = parseInt(accentHex.slice(1,3),16); var _g = parseInt(accentHex.slice(3,5),16); var _b = parseInt(accentHex.slice(5,7),16); var _hr = Math.max(0,_r-20); var _hg = Math.max(0,_g-20); var _hb = Math.max(0,_b-20); %>
    :root { --accent: <%= accentHex %>; --accent-rgb: <%= _r %>,<%= _g %>,<%= _b %>; --accent-hover: #<%= _hr.toString(16).padStart(2,'0') %><%= _hg.toString(16).padStart(2,'0') %><%= _hb.toString(16).padStart(2,'0') %>; }
    .card {
      background: #1A1C1E; border: 1px solid rgba(255,255,255,0.06);
      border-radius: 20px; padding: 48px 40px; max-width: 480px; width: 90%;
      text-align: center;
    }
    .icon {
      width: 72px; height: 72px; border-radius: 50%;
      background: rgba(16,185,129,0.15); margin: 0 auto 24px;
      display: flex; align-items: center; justify-content: center;
    }
    .icon svg { width: 36px; height: 36px; stroke: #10B981; }
    h1 { font-size: 24px; font-weight: 800; margin-bottom: 8px; }
    p { color: rgba(255,255,255,0.6); font-size: 14px; line-height: 1.6; margin-bottom: 8px; }
    .amount { font-size: 32px; font-weight: 800; color: #10B981; margin: 16px 0; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 14px 28px; border-radius: 12px; text-decoration: none;
      font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer;
      margin-top: 20px;
    }
    .btn-primary { background: linear-gradient(135deg, #10B981, #059669); color: #fff; }
    .detail { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 16px; }
    @media (max-width: 480px) { .card { padding: 32px 20px; } .icon { width: 56px; height: 56px; margin-bottom: 16px; } .icon svg { width: 28px; height: 28px; } h1 { font-size: 20px; } .amount { font-size: 26px; } .btn { padding: 12px 24px; font-size: 13px; } }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </div>
    <h1>Оплата прошла успешно!</h1>
    <% if (order) { %>
      <p>Заказ от игрока <strong style="color:#fff"><%= order.nickname %></strong></p>
      <div class="amount"><%= order.amount.toLocaleString('ru-RU') %> ₽</div>
      <div class="detail">Номер заказа: #<%= order.id.slice(0, 8) %></div>
    <% } else { %>
      <p>Спасибо за покупку на сервере Wayfis!</p>
    <% } %>
    <p style="font-size:13px;margin-top:12px">Донат будет выдан автоматически в ближайшее время.<br>Если возникнут вопросы — напиши администратору.</p>
    <a href="/" class="btn btn-primary">Вернуться в магазин</a>
  </div>
</body>
</html>
