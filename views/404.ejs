<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>404 — <%= settings.shop_name || 'Магазин' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    <% var accentHex = settings.theme_accent || '#10B981'; var _r = parseInt(accentHex.slice(1,3),16); var _g = parseInt(accentHex.slice(3,5),16); var _b = parseInt(accentHex.slice(5,7),16); var _hr = Math.max(0,_r-20); var _hg = Math.max(0,_g-20); var _hb = Math.max(0,_b-20); %>
    :root { --accent: <%= accentHex %>; --accent-rgb: <%= _r %>,<%= _g %>,<%= _b %>; --accent-hover: #<%= _hr.toString(16).padStart(2,'0') %><%= _hg.toString(16).padStart(2,'0') %><%= _hb.toString(16).padStart(2,'0') %>; --bg: #0E0F10; --font: 'Inter', sans-serif; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font); background: var(--bg); color: #fff; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .card { text-align: center; padding: 48px; }
    .code { font-size: 96px; font-weight: 900; color: var(--accent); line-height: 1; margin-bottom: 8px; }
    .title { font-size: 24px; font-weight: 700; margin-bottom: 12px; }
    .desc { color: rgba(255,255,255,0.5); font-size: 14px; margin-bottom: 24px; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 10px; background: var(--accent); color: #fff; text-decoration: none; font-size: 14px; font-weight: 700; font-family: inherit; }
    @media (max-width: 480px) { .card { padding: 32px 16px; } .code { font-size: 64px; } .title { font-size: 20px; } }
  </style>
</head>
<body>
  <div class="card">
    <div class="code">404</div>
    <div class="title">Страница не найдена</div>
    <div class="desc">Страницы <code style="background:rgba(255,255,255,0.06);padding:2px 6px;border-radius:4px"><%= path %></code> не существует</div>
    <a href="/" class="btn">На главную</a>
  </div>
</body>
</html>
