<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= settings.shop_name || 'Wayfis' %> — Система Автодоната</title>
  <meta name="description" content="<%= settings.shop_description || 'Купить донат на сервере Wayfis. Привилегии, кейсы и предметы с моментальной выдачей.' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/shop.css">
  <% var accentHex = settings.theme_accent || '#10B981'; var _r = parseInt(accentHex.slice(1,3),16); var _g = parseInt(accentHex.slice(3,5),16); var _b = parseInt(accentHex.slice(5,7),16); var _hr = Math.max(0,_r-20); var _hg = Math.max(0,_g-20); var _hb = Math.max(0,_b-20); %>
  <style>:root{--accent:<%= accentHex %>;--accent-rgb:<%= _r %>,<%= _g %>,<%= _b %>;--accent-hover:#<%= _hr.toString(16).padStart(2,'0') %><%= _hg.toString(16).padStart(2,'0') %><%= _hb.toString(16).padStart(2,'0') %>}</style>
  <link rel="icon" href="/img/64d91454-f20d-4320-8173-efc0155c1f4b.png">
  <meta property="og:title" content="<%= settings.shop_name || 'Wayfis' %> — Система Автодоната">
  <meta property="og:description" content="<%= settings.shop_description || 'Купить донат на сервере Wayfis.' %>">
  <meta name="theme-color" content="#0E0F10">
</head>
<body>
  <div class="site-wrapper">
    <!-- ========== HEADER ========== -->
    <header class="header">
      <div class="container header-inner">
        <a href="/" class="logo">
          <img src="/img/64d91454-f20d-4320-8173-efc0155c1f4b.png" alt="Wayfis" class="logo-img">
          <span class="logo-text">Wayfis</span>
        </a>
        <nav class="nav">
          <a href="#products">Товары</a>
          <a href="#about">О сервере</a>
          <a href="#faq">FAQ</a>
        </nav>
        <button class="hamburger" onclick="toggleMobileNav()" aria-label="Меню">
          <span></span><span></span><span></span>
        </button>
        <button onclick="openCart()" class="cart-btn" aria-label="Корзина">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
          </svg>
          <span class="cart-btn-label">Корзина</span>
          <span id="header-cart-count" class="cart-badge" style="display:none">0</span>
        </button>
      </div>
    </header>

    <!-- ========== HERO ========== -->
    <section class="hero" id="hero">
      <div class="hero-bg"></div>
      <div class="container hero-inner">
        <div class="hero-content">
          <h1 class="hero-title"><%= settings.hero_title || 'Грядущее обновление уже на подходе' %></h1>
          <p class="hero-subtitle">Привилегии, кейсы и предметы с моментальной выдачей</p>
          <div class="hero-ip">
            <div class="hero-ip-input">
              <span class="hero-ip-label">IP сервера</span>
              <span class="hero-ip-address"><%= settings.server_ip || 'mc.hipexmc.su' %></span>
            </div>
            <button onclick="copyIP()" class="btn btn-primary hero-copy-btn" id="copy-ip-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              <span>Скопировать IP</span>
            </button>
          </div>
          <div class="hero-online">
            <div class="hero-online-info">
              <span class="hero-online-label">Онлайн</span>
              <span class="hero-online-count"><span id="online-current"><%= settings.online_count || '0' %></span><span class="hero-online-max">/<%= settings.online_max || '20' %></span></span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" id="online-bar" style="width:<%= settings.online_max && settings.online_count ? Math.min(Math.round(settings.online_count/settings.online_max*100),100) : '0' %>%"></div>
            </div>
          </div>
        </div>
        <div class="hero-image">
          <img src="/img/hero-5.png" alt="Hero" class="hero-img">
        </div>
      </div>
    </section>

    <!-- ========== PRODUCTS ========== -->
    <section class="section" id="products">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Товары</h2>
          <p class="section-desc">Выбери привилегию и получи её моментально</p>
        </div>
        <div class="categories" id="categories">
          <button class="category-btn active" onclick="filterCategory(this, 'all')">Все</button>
          <% categories.forEach(function(c) { %>
            <button class="category-btn" onclick="filterCategory(this, '<%= c.id %>')"><%= c.name %></button>
          <% }); %>
        </div>
        <div class="products-grid" id="products-grid">
          <% products.forEach(function(p) { %>
          <div class="product-card" data-category="<%= p.category_id || '' %>" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-icon="<%= p.icon_url || '' %>">
            <% if (p.badge) { %><span class="product-badge"><%= p.badge %></span><% } %>
            <a href="/product/<%= p.id %>" class="product-image product-image-link">
              <% if (p.icon_url) { %>
              <img src="<%= p.icon_url %>" alt="<%= p.name %>" loading="lazy">
              <% } %>
            </a>
            <div class="product-info">
              <a href="/product/<%= p.id %>" class="product-name product-name-link"><%= p.name %></a>
              <p class="product-desc"><%= p.description || '' %></p>
              <div class="product-pricing">
                <% if (p.old_price) { %><span class="product-old-price"><%= p.old_price %> ₽</span><% } %>
                <span class="product-price"><%= p.price %> ₽</span>
              </div>
            </div>
            <div class="product-actions">
              <button onclick="addToCart(this)" class="btn btn-primary btn-sm product-add-btn">В корзину</button>
              <button onclick="buyNow(this)" class="btn btn-lightning" title="Купить сразу">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
              </button>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- ========== ABOUT ========== -->
    <section class="section section-alt" id="about">
      <div class="container">
        <div class="about-grid">
          <div class="about-content">
            <h2 class="section-title">О сервере <span id="about-online-count" class="text-accent"><%= settings.online_count || '0' %></span> человек онлайн</h2>
            <p class="about-text">
              Wayfis — это анархия без приватов, без запретов и донатных привилегий.
              Честная игра, где всё решает твоё мастерство.
            </p>
            <div class="about-stats">
              <div class="about-stat">
                <span class="about-stat-value"><%= settings.server_version_from || '1.21' %>-<%= settings.server_version_to || '1.21.11' %></span>
                <span class="about-stat-label">Версия</span>
              </div>
              <div class="about-stat">
                <span class="about-stat-value"><%= settings.server_mode || 'Анархия' %></span>
                <span class="about-stat-label">Режим</span>
              </div>
            </div>
            <button onclick="copyIP()" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              Скопировать IP: <%= settings.server_ip || 'mc.hipexmc.su' %>
            </button>
          </div>
          <div class="about-monitor">
            <div class="monitor-card">
              <div class="monitor-header">
                <span class="monitor-dot"></span>
                <span>Мониторинг</span>
              </div>
              <div class="monitor-body">
                <div class="monitor-players">
                  <span class="monitor-count"><%= settings.online_count || '0' %>/<%= settings.online_max || '20' %></span>
                  <span class="monitor-label">игроков онлайн</span>
                </div>
                <div class="progress-bar">
                  <div class="progress-fill" style="width:<%= settings.online_max && settings.online_count ? Math.min(Math.round(settings.online_count/settings.online_max*100),100) : '0' %>%"></div>
                </div>
                <div class="monitor-address">
                  <span class="monitor-address-label">Адрес</span>
                  <span class="monitor-address-ip"><%= settings.server_ip || 'mc.hipexmc.su' %></span>
                  <button onclick="copyIP()" class="monitor-copy-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== LAST BUYERS ========== -->
    <section class="section" id="buyers">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Последние покупки</h2>
          <p class="section-desc">Огромная благодарность этим игрокам за поддержку сервера</p>
        </div>
        <div class="buyers-grid">
          <% if (recentOrders && recentOrders.length > 0) { %>
            <% recentOrders.forEach(function(o) { %>
            <div class="buyer-card">
              <img src="https://mc-heads.net/avatar/<%= o.nickname %>/48" alt="<%= o.nickname %>" class="buyer-avatar" loading="lazy">
              <div class="buyer-info">
                <span class="buyer-name"><%= o.nickname %></span>
                <span class="buyer-amount"><%= o.amount %> ₽</span>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <div class="buyers-empty">Покупок пока нет — будь первым!</div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- ========== FAQ ========== -->
    <section class="section section-alt" id="faq">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Частые вопросы</h2>
        </div>
        <div class="faq-list">
          <% faqs.forEach(function(f) { %>
          <details class="faq-item">
            <summary class="faq-question"><%= f.question %></summary>
            <div class="faq-answer"><%= f.answer %></div>
          </details>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- ========== CTA ========== -->
    <section class="section cta-section">
      <div class="container cta-inner">
        <div class="cta-content">
          <h2 class="cta-title">Готов поддержать проект?</h2>
          <p class="cta-text">Выбери привилегию выше — донат поступит моментально, а имя попадёт в список благодарностей.</p>
          <a href="#products" class="btn btn-primary btn-lg">К покупкам</a>
        </div>
        <div class="cta-image">
          <img src="/img/hero-5.png" alt="" loading="lazy">
        </div>
      </div>
    </section>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <img src="/img/64d91454-f20d-4320-8173-efc0155c1f4b.png" alt="Wayfis" class="footer-logo">
          <span class="footer-name">Wayfis</span>
        </div>
        <div class="footer-links">
          <a href="<%= settings.telegram_url || '#' %>" class="footer-social telegram" target="_blank" rel="noopener" aria-label="Telegram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M21.92 3.04a1.32 1.32 0 0 0-1.36-.18L2.36 10.27a1.32 1.32 0 0 0 .05 2.46l4.13 1.45 2.27 6.95a.99.99 0 0 0 1.71.32l2.7-2.9 4.6 3.35a1.32 1.32 0 0 0 2.09-.8l3.34-15.41a1.32 1.32 0 0 0-.43-1.65z"/></svg>
          </a>
          <a href="<%= settings.youtube_url || '#' %>" class="footer-social youtube" target="_blank" rel="noopener" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="container">
          <span><%= settings.footer_text || '© Wayfis — Система Автодоната. Все права защищены.' %></span>
          <div style="margin-top:8px;display:flex;gap:16px;justify-content:center;font-size:12px">
            <a href="/terms" style="color:rgba(255,255,255,0.4);text-decoration:none">Пользовательское соглашение</a>
            <a href="/privacy" style="color:rgba(255,255,255,0.4);text-decoration:none">Условия сервиса</a>
            <a href="/profile/orders" style="color:rgba(255,255,255,0.4);text-decoration:none">Мои заказы</a>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <!-- ========== MOBILE NAV ========== -->
  <div id="mnav-overlay" class="mnav-overlay" onclick="closeMobileNav()"></div>
  <div id="mnav-panel" class="mnav-panel">
    <div class="mnav-header">
      <span class="mnav-title">Меню</span>
      <button class="mnav-close" onclick="closeMobileNav()">✕</button>
    </div>
    <div class="mnav-links">
      <a href="#products" onclick="closeMobileNav()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        Товары
      </a>
      <a href="#about" onclick="closeMobileNav()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        О сервере
      </a>
      <a href="#faq" onclick="closeMobileNav()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        FAQ
      </a>
      <a href="/terms" onclick="closeMobileNav()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        Соглашение
      </a>
      <a href="/profile/orders" onclick="closeMobileNav()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Мои заказы
      </a>
    </div>
  </div>

  <!-- ========== CART MODAL ========== -->
  <div id="cart-overlay" class="cart-overlay" onclick="closeCart()"></div>
  <div id="cart-modal" class="cart-modal">
    <div class="cart-modal-header">
      <h3 class="cart-modal-title">Корзина · <span id="cart-count">0</span></h3>
      <button onclick="closeCart()" class="cart-close-btn">✕</button>
    </div>
    <div class="cart-modal-body" id="cart-items">
      <div class="cart-empty">Корзина пуста</div>
    </div>
    <div class="cart-modal-footer">
      <div class="cart-input-group">
        <svg class="cart-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <input id="cart-nick" type="text" placeholder="Твой ник в Minecraft" class="cart-input">
      </div>
      <div class="cart-input-group">
        <svg class="cart-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-0.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2"/><circle cx="10" cy="10" r="1"/></svg>
        <input id="cart-promo" type="text" placeholder="Промокод (если есть)" class="cart-input">
      </div>
      <div class="cart-total-row">
        <span class="cart-total-label">Итого</span>
        <span class="cart-total-price" id="cart-total">0 ₽</span>
      </div>
      <div class="cart-actions">
        <button onclick="clearCart()" class="btn btn-outline btn-sm">Очистить</button>
        <button onclick="checkout()" id="cart-checkout-btn" class="btn btn-primary cart-pay-btn">Оплатить →</button>
      </div>
    </div>
  </div>

  <!-- ========== TOAST CONTAINER ========== -->
  <div id="toast-container" class="toast-container"></div>

  <!-- ========== TERMS MODAL ========== -->
  <div id="tmodal-overlay" class="tmodal-overlay" onclick="closeTermsModal(event)">
    <div class="tmodal" onclick="event.stopPropagation()">
      <button class="tmodal-close" onclick="closeTermsModal()">✕</button>
      <div class="tmodal-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
      </div>
      <div class="tmodal-title">Пользовательское соглашение</div>
      <div class="tmodal-sub">Пожалуйста, ознакомьтесь и примите условия, чтобы продолжить</div>
      <div class="tmodal-terms">
        <p>Нажимая «Принимаю», вы соглашаетесь с условиями приобретения товаров и услуг:</p>
        <br>
        <p><strong>1.</strong> Товары являются цифровыми и не подлежат возврату после выдачи.</p>
        <p><strong>2.</strong> Выдача происходит автоматически в течение нескольких секунд после оплаты.</p>
        <p><strong>3.</strong> Администрация не несёт ответственности за утерю товара по вине игрока.</p>
        <p><strong>4.</strong> Запрещено оспаривать платёж (чарджбэк) — это ведёт к блокировке.</p>
        <p><strong>5.</strong> Возврат средств возможен только до момента выдачи товара.</p>
      </div>
      <div class="tmodal-actions">
        <button class="tmodal-btn tmodal-btn-secondary" onclick="closeTermsModal()">Отказаться</button>
        <button class="tmodal-btn tmodal-btn-primary" id="tmodal-accept-btn" onclick="acceptTerms()">
          Принимаю
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <script>
  // ========== MOBILE NAV ==========
  function toggleMobileNav() {
    document.getElementById('mnav-overlay').classList.toggle('active');
    document.getElementById('mnav-panel').classList.toggle('active');
    document.querySelector('.hamburger').classList.toggle('active');
  }
  function closeMobileNav() {
    document.getElementById('mnav-overlay').classList.remove('active');
    document.getElementById('mnav-panel').classList.remove('active');
    document.querySelector('.hamburger').classList.remove('active');
  }

  // ========== TERMS MODAL ==========
  var termsCallback = null;
  function showTermsModal(callback) { termsCallback = callback; document.getElementById('tmodal-overlay').classList.add('active'); }
  function closeTermsModal(e) { if (e && e.target !== e.currentTarget) return; document.getElementById('tmodal-overlay').classList.remove('active'); termsCallback = null; }
  function acceptTerms() { document.getElementById('tmodal-overlay').classList.remove('active'); if (termsCallback) { termsCallback(); termsCallback = null; } }

  // ========== CART ==========
  var cart = [];

  function saveCart() {
    document.cookie = 'cart=' + encodeURIComponent(JSON.stringify(cart)) + ';path=/;max-age=604800';
    var nick = document.getElementById('cart-nick').value;
    document.cookie = 'cart_nick=' + encodeURIComponent(nick) + ';path=/;max-age=604800';
  }

  function loadCart() {
    var m = document.cookie.match(/cart=([^;]+)/);
    if (m) { try { cart = JSON.parse(decodeURIComponent(m[1])); } catch(e) { cart = []; } }
    var n = document.cookie.match(/cart_nick=([^;]+)/);
    if (n) { var inp = document.getElementById('cart-nick'); if (inp) inp.value = decodeURIComponent(n[1]); }
  }

  function addToCart(btn) {
    var card = btn.closest('[data-id]');
    var id = card.dataset.id;
    var existing = cart.find(function(i){ return i.id === id; });
    if (existing) { existing.qty++; } else {
      cart.push({ id: id, name: card.dataset.name, price: Number(card.dataset.price), icon: card.dataset.icon, qty: 1 });
    }
    saveCart(); renderCart(); showToast(card.dataset.name + ' добавлен в корзину');
  }

  function buyNow(btn) {
    showTermsModal(function() {
      var card = btn.closest('[data-id]');
      var id = card.dataset.id;
      cart = [{ id: id, name: card.dataset.name, price: Number(card.dataset.price), icon: card.dataset.icon, qty: 1 }];
      saveCart(); renderCart(); openCart();
    });
  }

  function changeQty(id, delta) {
    var item = cart.find(function(i){ return i.id === id; });
    if (!item) return;
    item.qty += delta;
    if (item.qty <= 0) cart = cart.filter(function(i){ return i.id !== id; });
    saveCart(); renderCart();
  }

  function removeItem(id) { cart = cart.filter(function(i){ return i.id !== id; }); saveCart(); renderCart(); }
  function clearCart() { cart = []; saveCart(); renderCart(); }

  function renderCart() {
    var items = document.getElementById('cart-items');
    var countEl = document.getElementById('cart-count');
    var headerCount = document.getElementById('header-cart-count');
    var totalEl = document.getElementById('cart-total');
    var checkoutBtn = document.getElementById('cart-checkout-btn');
    var totalQty = 0, totalPrice = 0;
    cart.forEach(function(i){ totalQty += i.qty; totalPrice += i.price * i.qty; });
    countEl.textContent = totalQty;
    headerCount.textContent = totalQty;
    headerCount.style.display = totalQty > 0 ? 'flex' : 'none';
    totalEl.textContent = totalPrice + ' \u20BD';
    checkoutBtn.textContent = 'Оплатить ' + totalPrice + ' \u20BD \u2192';
    if (totalQty === 0) { items.innerHTML = '<div class="cart-empty">Корзина пуста</div>'; return; }
    var html = '';
    cart.forEach(function(item) {
      html += '<div class="cart-item">';
      if (item.icon) html += '<img src="' + item.icon + '" class="cart-item-img">';
      html += '<div class="cart-item-info"><div class="cart-item-name">' + item.name + '</div><div class="cart-item-price">' + item.price + ' \u20BD</div></div>';
      html += '<div class="cart-item-qty"><button onclick="changeQty(\'' + item.id + '\',-1)" class="qty-btn">\u2212</button>';
      html += '<span class="qty-value">' + item.qty + '</span>';
      html += '<button onclick="changeQty(\'' + item.id + '\',1)" class="qty-btn">+</button>';
      html += '<button onclick="removeItem(\'' + item.id + '\')" class="qty-remove">\u2715</button></div></div>';
    });
    items.innerHTML = html;
  }

  function openCart() {
    document.getElementById('cart-overlay').classList.add('active');
    document.getElementById('cart-modal').classList.add('active');
    renderCart();
  }

  function closeCart() {
    document.getElementById('cart-overlay').classList.remove('active');
    document.getElementById('cart-modal').classList.remove('active');
    saveCart();
  }

  function checkout() {
    showTermsModal(function() {
      var nick = document.getElementById('cart-nick').value.trim();
      if (!nick) { showToast('Введите ник в Minecraft'); return; }
      if (cart.length === 0) { showToast('Корзина пуста'); return; }
      var btn = document.getElementById('cart-checkout-btn');
      btn.disabled = true; btn.textContent = 'Обработка...';
      var promo = document.getElementById('cart-promo').value.trim();
      fetch('/pay/create', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nick: nick, items: cart, promo: promo })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.error) { showToast(data.error); btn.disabled = false; btn.textContent = 'Оплатить →'; return; }
        cart = []; saveCart(); renderCart(); closeCart();
        window.location.href = data.redirect;
      })
      .catch(function() {
        showToast('Ошибка при создании платежа. Попробуй ещё раз.');
        btn.disabled = false; btn.textContent = 'Оплатить →';
      });
    });
  }

  // ========== CATEGORY FILTER ==========
  function filterCategory(btn, id) {
    document.querySelectorAll('.category-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    document.querySelectorAll('.product-card').forEach(function(card) {
      var cat = card.dataset.category;
      card.style.display = (id === 'all' || cat === id) ? 'flex' : 'none';
    });
  }

  // ========== COPY IP ==========
  function copyIP() {
    var ip = '<%= settings.server_ip || 'mc.hipexmc.su' %>';
    navigator.clipboard.writeText(ip).then(function() {
      var btn = document.getElementById('copy-ip-btn');
      if (btn) {
        var orig = btn.innerHTML;
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Скопировано!';
        setTimeout(function(){ btn.innerHTML = orig; }, 2000);
      }
      showToast('IP скопирован: ' + ip);
    });
  }

  // ========== TOAST ==========
  function showToast(msg) {
    var c = document.getElementById('toast-container');
    var t = document.createElement('div');
    t.className = 'toast';
    t.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>' + msg;
    c.appendChild(t);
    setTimeout(function(){ t.classList.add('toast-hide'); setTimeout(function(){ t.remove(); }, 300); }, 2500);
  }

  // ========== LIVE ONLINE ==========
  function updateOnline() {
    fetch('/api/online').then(function(r){ return r.json(); }).then(function(d){
      var el = document.getElementById('online-current');
      var bar = document.getElementById('online-bar');
      var maxEl = document.querySelector('.hero-online-max');
      var aboutOnline = document.getElementById('about-online-count');
      var monitorCount = document.querySelector('.monitor-count');
      var monitorBars = document.querySelectorAll('.monitor-card .progress-fill, .about-monitor .progress-fill');
      if (el) el.textContent = d.online;
      if (bar) bar.style.width = d.percent + '%';
      if (maxEl) maxEl.textContent = '/' + d.max;
      if (aboutOnline) aboutOnline.textContent = d.online;
      if (monitorCount) monitorCount.innerHTML = d.online + '/' + d.max;
      monitorBars.forEach(function(b){ b.style.width = d.percent + '%'; });
    }).catch(function(){});
  }
  setInterval(updateOnline, 30000);

  // ========== INIT ==========
  document.addEventListener('DOMContentLoaded', function() {
    loadCart(); renderCart();
    var nickInput = document.getElementById('cart-nick');
    if (nickInput) nickInput.addEventListener('input', saveCart);
  });
  </script>
</body>
</html>
