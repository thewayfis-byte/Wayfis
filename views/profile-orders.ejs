<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Мои заказы — <%= settings.shop_name || 'Магазин' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    <% var accentHex = settings.theme_accent || '#10B981'; var _r = parseInt(accentHex.slice(1,3),16); var _g = parseInt(accentHex.slice(3,5),16); var _b = parseInt(accentHex.slice(5,7),16); var _hr = Math.max(0,_r-20); var _hg = Math.max(0,_g-20); var _hb = Math.max(0,_b-20); %>
    :root { --accent: <%= accentHex %>; --accent-rgb: <%= _r %>,<%= _g %>,<%= _b %>; --accent-hover: #<%= _hr.toString(16).padStart(2,'0') %><%= _hg.toString(16).padStart(2,'0') %><%= _hb.toString(16).padStart(2,'0') %>; --bg: #0E0F10; --font: 'Inter', sans-serif; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font); background: var(--bg); color: rgba(255,255,255,0.8); min-height: 100vh; }
    .container { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
    h1 { font-size: 24px; font-weight: 800; color: #fff; margin-bottom: 24px; }
    .search-box { display: flex; gap: 12px; margin-bottom: 24px; }
    .search-box input { flex: 1; padding: 12px 16px; border-radius: 10px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); color: #fff; font-size: 15px; font-family: inherit; outline: none; }
    .search-box input:focus { border-color: var(--accent); }
    .search-box button { padding: 12px 24px; border-radius: 10px; background: var(--accent); color: #fff; border: none; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .card { background: #1A1C1E; border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; overflow: hidden; margin-bottom: 12px; }
    .card-body { padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
    .order-info .order-product { font-weight: 700; color: #fff; font-size: 15px; }
    .order-info .order-date { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 2px; }
    .order-amount { font-size: 18px; font-weight: 800; color: var(--accent); }
    .empty { text-align: center; padding: 48px; color: rgba(255,255,255,0.35); }
    .back-btn { display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.5); text-decoration: none; font-size: 14px; margin-bottom: 20px; }
    .back-btn:hover { color: #fff; }
    @media (max-width: 480px) { .container { padding: 24px 16px; } h1 { font-size: 20px; } .search-box { flex-direction: column; gap: 8px; } .search-box input { font-size: 14px; padding: 10px 14px; } .search-box button { padding: 10px 20px; } .card-body { padding: 12px 14px; flex-direction: column; align-items: flex-start; gap: 8px; } .order-amount { font-size: 16px; } }
  </style>
</head>
<body>
  <div class="container">
    <a href="/" class="back-btn">← На главную</a>
    <h1>Мои заказы</h1>
    <form class="search-box" method="GET">
      <input type="text" name="nick" placeholder="Введи свой ник в Minecraft" value="<%= nick %>" required>
      <button type="submit">Найти</button>
    </form>
    <% if (nick) { %>
      <% if (orders.length === 0) { %>
        <div class="empty">У игрока <strong style="color:#fff"><%= nick %></strong> нет оплаченных заказов</div>
      <% } else { %>
        <% orders.forEach(function(o) { %>
          <div class="card">
            <div class="card-body">
              <div class="order-info">
                <div class="order-product"><%= o.product_name || 'Товар' %></div>
                <div class="order-date"><%= new Date(o.created_at).toLocaleString('ru-RU') %> · #<%= o.id.slice(0,8) %></div>
              </div>
              <div class="order-amount"><%= o.amount %> ₽</div>
            </div>
          </div>
        <% }); %>
      <% } %>
    <% } %>
  </div>
</body>
</html>
