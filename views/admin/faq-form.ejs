<%- include('layout', { active: 'store', title: faq ? 'Редактировать вопрос' : 'Добавить вопрос' }) %>

<div class="page-header">
  <h1><%= faq ? 'Редактировать вопрос' : 'Добавить вопрос' %></h1>
</div>

<form method="POST" style="max-width:640px">
  <div class="card">
    <div class="card-body">
      <div class="form-group">
        <label>Вопрос *</label>
        <input type="text" name="question" required value="<%= faq ? faq.question : '' %>">
      </div>
      <div class="form-group">
        <label>Ответ *</label>
        <textarea name="answer" required rows="4"><%= faq ? faq.answer : '' %></textarea>
      </div>
      <div class="form-group">
        <label>Порядок сортировки</label>
        <input type="number" name="sort_order" value="<%= faq ? faq.sort_order : '0' %>">
      </div>
    </div>
  </div>
  <div style="display:flex;gap:10px;margin-top:16px">
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a href="/admin/faqs" class="btn btn-ghost">Отмена</a>
  </div>
</form>

</div>
</body>
</html>
