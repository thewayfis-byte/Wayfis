<%- include('layout', { active: 'partners', title: partner ? 'Редактировать партнёра' : 'Новый партнёр' }) %>

<div class="page-header">
  <h1><%= partner ? 'Редактировать партнёра' : 'Новый партнёр' %></h1>
</div>

<form method="POST" style="max-width:600px">
  <div class="card" style="margin-bottom:20px">
    <div class="card-header"><h3>Основное</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label>Никнейм в Minecraft</label>
        <input type="text" name="nickname" value="<%= partner ? partner.nickname : '' %>" required>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Партнёрская ссылка (код)</label>
          <input type="text" name="referral_code" value="<%= partner ? partner.referral_code : '' %>" required>
        </div>
        <div class="form-group">
          <label>Комиссия (%)</label>
          <input type="number" name="commission_percent" value="<%= partner ? partner.commission_percent : '10' %>" min="1" max="50">
        </div>
      </div>
      <div class="form-group" style="display:flex;align-items:center;gap:10px">
        <input type="checkbox" name="active" id="active" <%= !partner || partner.active ? 'checked' : '' %>>
        <label for="active" style="margin:0;cursor:pointer">Активен</label>
      </div>
    </div>
  </div>
  <div style="display:flex;gap:10px;margin-bottom:32px">
    <button type="submit" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Сохранить
    </button>
    <a href="/admin/partners" class="btn btn-outline">Отмена</a>
  </div>
</form>

</div>
</body>
</html>