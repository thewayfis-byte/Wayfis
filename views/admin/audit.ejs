<%- include('layout', { active: 'audit', title: 'Аудит' }) %>

<div class="page-header">
  <h1>Аудит действий</h1>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Действие</th>
        <th>Детали</th>
        <th>Дата</th>
      </tr>
    </thead>
    <tbody>
      <% if (logs.length === 0) { %>
        <tr><td colspan="3" class="empty">Нет записей</td></tr>
      <% } else { %>
        <% logs.forEach(function(l) { %>
          <tr>
            <td><span class="badge badge-gray"><%= l.action %></span></td>
            <td style="font-size:12px;color:rgba(255,255,255,0.5)"><%= l.details || '—' %></td>
            <td style="font-size:12px;color:rgba(255,255,255,0.4)"><%= new Date(l.created_at).toLocaleString('ru-RU') %></td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table></div>
</div>

</div>
</body>
</html>