<%- include('layout', { active: 'promos', title: promo ? 'Редактировать промокод' : 'Новый промокод' }) %>

<div class="page-header">
  <h1><%= promo ? 'Редактировать промокод' : 'Новый промокод' %></h1>
</div>

<form method="POST" style="max-width:600px">
  <div class="card" style="margin-bottom:20px">
    <div class="card-header"><h3>Основное</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label>Код промокода</label>
        <input type="text" name="code" value="<%= promo ? promo.code : '' %>" required style="text-transform:uppercase">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Тип скидки</label>
          <select name="discount_type">
            <option value="percent" <%= promo && promo.discount_type === 'percent' ? 'selected' : '' %>%>Процент (%)</option>
            <option value="fixed" <%= promo && promo.discount_type === 'fixed' ? 'selected' : '' %>>Фиксированная (₽)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Значение скидки</label>
          <input type="number" name="discount_value" value="<%= promo ? promo.discount_value : '' %>" required min="1">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Макс. использований (0 = без лимита)</label>
          <input type="number" name="max_uses" value="<%= promo ? (promo.max_uses || 0) : 0 %>" min="0">
        </div>
        <div class="form-group">
          <label>Срок действия (пусто = бессрочно)</label>
          <input type="date" name="expires_at" value="<%= promo && promo.expires_at ? new Date(promo.expires_at).toISOString().split('T')[0] : '' %>">
        </div>
      </div>
      <div class="form-group" style="display:flex;align-items:center;gap:10px">
        <input type="checkbox" name="active" id="active" <%= !promo || promo.active ? 'checked' : '' %>>
        <label for="active" style="margin:0;cursor:pointer">Активен</label>
      </div>
    </div>
  </div>
  <div style="display:flex;gap:10px;margin-bottom:32px">
    <button type="submit" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Сохранить
    </button>
    <a href="/admin/promos" class="btn btn-outline">Отмена</a>
  </div>
</form>

</div>
</body>
</html>