<%- include('layout', { active: 'partners', title: 'Партнёры' }) %>

<div class="page-header">
  <h1>Партнёры</h1>
  <a href="/admin/partners/create" class="btn btn-primary">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
    Добавить партнёра
  </a>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Никнейм</th>
        <th>Ссылка</th>
        <th>Скидка (%)</th>
        <th>Заработано</th>
        <th>Статус</th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
      <% if (partners.length === 0) { %>
        <tr><td colspan="6" class="empty">Партнёры пока не добавлены</td></tr>
      <% } else { %>
        <% partners.forEach(p => { %>
          <tr>
            <td><strong><%= p.nickname %></strong></td>
            <td><%= p.referral_code %></td>
            <td><%= p.commission_percent %>%</td>
            <td><%= p.total_earned %> ₽</td>
            <td><span class="badge <%= p.active ? 'badge-green' : 'badge-gray' %>"><%= p.active ? 'Активен' : 'Выкл.' %></span></td>
            <td class="actions">
              <a href="/admin/partners/edit/<%= p.id %>" class="btn btn-ghost btn-sm">Ред.</a>
              <form method="POST" action="/admin/partners/delete/<%= p.id %>" style="display:inline" onsubmit="return confirm('Удалить партнёра?')">
                <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table></div>
</div>

</div>
</body>
</html>