<%- include('layout', { active: 'catalog', title: product ? 'Редактирование: ' + product.name : 'Новый товар' }) %>

<div class="pf-page">
  <div class="pf-card">
    <div class="pf-header">
      <h1 class="pf-title"><%= product ? 'Редактирование: ' + product.name : 'Новый товар' %></h1>
      <a href="/admin/products" class="pf-close">✕</a>
    </div>

    <form method="POST" enctype="multipart/form-data" id="product-form">

      <div class="pf-section">
        <label class="pf-label">Тип товара</label>
        <div class="pf-type-group">
          <label class="pf-type-option <%= !product || product.product_type === 'single' ? 'active' : '' %>">
            <input type="radio" name="product_type" value="single" <%= !product || product.product_type === 'single' ? 'checked' : '' %> onchange="updateType(this)">
            <div class="pf-type-card">
              <div class="pf-type-title">Поступно</div>
              <div class="pf-type-desc">Фикс. цена за 1 покупку</div>
            </div>
          </label>
          <label class="pf-type-option <%= product && product.product_type === 'quantity' ? 'active' : '' %>">
            <input type="radio" name="product_type" value="quantity" <%= product && product.product_type === 'quantity' ? 'checked' : '' %> onchange="updateType(this)">
            <div class="pf-type-card">
              <div class="pf-type-title">С количеством</div>
              <div class="pf-type-desc">Покупатель выбирает шт.</div>
            </div>
          </label>
        </div>
      </div>

      <div class="pf-section">
        <div class="pf-row">
          <div class="pf-col-wide">
            <label class="pf-label">Название товара</label>
            <input type="text" name="name" required value="<%= product ? product.name : '' %>" class="pf-input" placeholder="Например: LUNAR">
          </div>
          <div class="pf-col-narrow">
            <label class="pf-label">Цена, ₽ (от 1 до 100 000)</label>
            <input type="number" name="price" required value="<%= product ? product.price : '' %>" class="pf-input" min="1" max="100000" placeholder="99">
          </div>
        </div>
      </div>

      <div class="pf-section">
        <label class="pf-label">Описание (одна строка под названием)</label>
        <input type="text" name="description" value="<%= product ? (product.description || '') : '' %>" class="pf-input" placeholder="30 дней доступа · /fly /hat /repair">
      </div>

      <div class="pf-section">
        <label class="pf-label">Подробное описание (необязательно)</label>
        <textarea name="long_description" rows="6" class="pf-textarea" placeholder="Описание"><%= product ? (product.long_description || '') : '' %></textarea>
      </div>

      <div class="pf-section">
        <div class="pf-row">
          <div class="pf-col-wide">
            <label class="pf-label">Старая цена (необязательно)</label>
            <input type="number" name="old_price" value="<%= product ? (product.old_price || '') : '' %>" class="pf-input" placeholder="990">
          </div>
          <div class="pf-col-wide">
            <label class="pf-label">Бейдж (необязательно)</label>
            <input type="text" name="badge" value="<%= product ? (product.badge || '') : '' %>" class="pf-input" placeholder="Выгодно, ХИТ, NEW, −20%">
          </div>
        </div>
      </div>

      <div class="pf-section">
        <label class="pf-label">Группа апгрейда (необязательно)</label>
        <input type="text" name="upgrade_group" value="<%= product ? (product.upgrade_group || '') : '' %>" class="pf-input" placeholder="Например: privileges">
        <div class="pf-hint">Товары с одинаковой группой заменяют друг друга. Если игрок уже купил товар выше по цене из этой группы — предыдущий заменится.</div>
      </div>

      <div class="pf-section">
        <label class="pf-label">Категория</label>
        <div class="pf-category-group">
          <% categories.forEach(function(c) { %>
            <label class="pf-cat-option <%= product && product.category_id === c.id ? 'active' : '' %>">
              <input type="radio" name="category_id" value="<%= c.id %>" <%= product && product.category_id === c.id ? 'checked' : '' %> onchange="selectCategory(this)">
              <span><%= c.name %></span>
            </label>
          <% }); %>
          <label class="pf-cat-option <%= !product || !product.category_id ? 'active' : '' %>" style="<%= (product && product.category_id) ? 'display:none' : '' %>">
            <input type="radio" name="category_id" value="" <%= !product || !product.category_id ? 'checked' : '' %> onchange="selectCategory(this)" style="display:none">
            <span>Без категории</span>
          </label>
        </div>
      </div>

      <div class="pf-section">
        <label class="pf-label">Изображение товара</label>
        <div class="pf-image-area">
          <% if (product && product.icon_url) { %>
            <div class="pf-image-preview" id="image-preview">
              <img src="<%= product.icon_url %>" id="preview-img">
              <input type="hidden" name="existing_icon" value="<%= product.icon_url %>">
            </div>
          <% } else { %>
            <div class="pf-image-preview empty" id="image-preview">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
          <% } %>
          <div class="pf-image-actions">
            <button type="button" class="pf-btn-secondary" onclick="document.getElementById('icon-input').click()">Заменить</button>
            <% if (product && product.icon_url) { %>
              <button type="button" class="pf-btn-danger" onclick="removeImage()">🗑</button>
            <% } %>
          </div>
          <input type="file" name="icon" accept="image/*" id="icon-input" style="display:none" onchange="previewImage(this)">
          <div class="pf-image-hint">512×512 px, PNG/JPG/WebP, до 5 МБ.</div>
        </div>
      </div>

      <div class="pf-section">
        <label class="pf-label">Команды после оплаты</label>
        <div class="pf-hint" style="margin-bottom:12px"><code>{player}</code> — ник игрока, <code>{quantity}</code> — количество, <code>{quantity * 10}</code> — количество с курсом</div>
        <div id="commands-list">
          <% if (product && product.commands_after_purchase) { %>
            <% var cmds = []; try { cmds = JSON.parse(product.commands_after_purchase); } catch(e) {} %>
            <% cmds.forEach(function(cmd, i) { %>
              <div class="pf-command-row">
                <input type="text" name="commands[]" value="<%= cmd %>" class="pf-input" placeholder="lp user {player} parent add lunar">
                <button type="button" class="pf-btn-remove" onclick="this.parentElement.remove()">🗑</button>
              </div>
            <% }); %>
          <% } %>
        </div>
        <button type="button" class="pf-btn-add-cmd" onclick="addCommand()">+ Команда</button>
      </div>

      <div class="pf-section">
        <label class="pf-toggle">
          <input type="checkbox" name="offline_give" <%= product && product.offline_give ? 'checked' : '' %>>
          <span class="pf-toggle-slider"></span>
          <div>
            <div class="pf-toggle-title">Выдавать, даже если игрок не в сети</div>
            <div class="pf-toggle-desc">Для проходок в whitelist (напр. <code>whitelist add {player}</code>): команда выполнится сразу после оплаты, не дожидаясь входа игрока.</div>
          </div>
        </label>
      </div>

      <div class="pf-section">
        <label class="pf-toggle">
          <input type="checkbox" name="hide_from_store" <%= product && product.hide_from_store ? 'checked' : '' %>>
          <span class="pf-toggle-slider"></span>
          <div>
            <div class="pf-toggle-title">Скрыть товар с витрины</div>
            <div class="pf-toggle-desc">Товар не виден покупателям и его нельзя купить, но он остаётся в настройках и доступен для тестовых покупек.</div>
          </div>
        </label>
      </div>

      <div class="pf-section">
        <label class="pf-toggle">
          <input type="checkbox" name="visible" <%= !product || product.visible ? 'checked' : '' %>>
          <span class="pf-toggle-slider"></span>
          <div>
            <div class="pf-toggle-title">Товар виден на сайте</div>
          </div>
        </label>
      </div>

      <div class="pf-section">
        <label class="pf-label">Порядок сортировки</label>
        <input type="number" name="sort_order" value="<%= product ? product.sort_order : '0' %>" class="pf-input" style="width:120px">
      </div>

      <div class="pf-footer">
        <a href="/admin/products" class="btn btn-outline">Отмена</a>
        <button type="submit" class="btn btn-primary pf-save-btn">Сохранить</button>
      </div>

    </form>
  </div>
</div>

<style>
.pf-page{padding:0;margin:-28px -32px;min-height:100vh;background:#111315}
.pf-card{max-width:720px;margin:0 auto;padding:32px 40px 40px}
.pf-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:32px}
.pf-title{font-size:24px;font-weight:800;color:#fff}
.pf-close{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);display:grid;place-items:center;text-decoration:none;font-size:18px;transition:all .15s}
.pf-close:hover{background:rgba(255,255,255,0.1);color:#fff}
.pf-section{margin-bottom:24px}
.pf-label{display:block;font-size:11px;font-weight:700;color:rgba(255,255,255,0.4);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px}
.pf-input{width:100%;padding:12px 16px;border-radius:10px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#fff;font-size:15px;font-weight:500;font-family:inherit;outline:none;transition:border-color .15s}
.pf-input:focus{border-color:#10B981}
.pf-input::placeholder{color:rgba(255,255,255,0.25)}
.pf-textarea{width:100%;padding:12px 16px;border-radius:10px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#fff;font-size:14px;font-family:inherit;outline:none;resize:vertical;min-height:100px;transition:border-color .15s}
.pf-textarea:focus{border-color:#10B981}
.pf-textarea::placeholder{color:rgba(255,255,255,0.25)}
.pf-hint{font-size:12px;color:rgba(255,255,255,0.35);margin-top:6px;line-height:1.5}
.pf-hint code{color:#10B981;font-weight:600;background:rgba(16,185,129,0.1);padding:1px 5px;border-radius:4px;font-size:11px}
.pf-row{display:grid;grid-template-columns:2fr 1fr;gap:16px}
.pf-col-wide,.pf-col-narrow{display:flex;flex-direction:column}
.pf-type-group{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pf-type-option{cursor:pointer}
.pf-type-option input{display:none}
.pf-type-card{padding:16px;border-radius:12px;background:rgba(255,255,255,0.03);border:2px solid rgba(255,255,255,0.08);transition:all .15s}
.pf-type-option.active .pf-type-card{border-color:#10B981;background:rgba(16,185,129,0.06)}
.pf-type-title{font-size:15px;font-weight:700;color:#fff;margin-bottom:4px}
.pf-type-desc{font-size:12px;color:rgba(255,255,255,0.4)}
.pf-category-group{display:flex;flex-wrap:wrap;gap:8px}
.pf-cat-option{cursor:pointer}
.pf-cat-option input{display:none}
.pf-cat-option span{display:inline-block;padding:8px 18px;border-radius:999px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);font-size:13px;font-weight:600;color:rgba(255,255,255,0.6);transition:all .15s}
.pf-cat-option.active span{background:rgba(16,185,129,0.15);border-color:#10B981;color:#10B981}
.pf-image-area{display:flex;flex-direction:column;gap:12px}
.pf-image-preview{width:200px;height:200px;border-radius:16px;background:rgba(255,255,255,0.03);border:2px dashed rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;overflow:hidden;transition:border-color .15s}
.pf-image-preview.empty{cursor:pointer}
.pf-image-preview.empty:hover{border-color:rgba(255,255,255,0.2)}
.pf-image-preview img{width:100%;height:100%;object-fit:contain;image-rendering:pixelated}
.pf-image-actions{display:flex;gap:8px}
.pf-btn-secondary{padding:8px 16px;border-radius:8px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7);font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .15s}
.pf-btn-secondary:hover{background:rgba(255,255,255,0.1);color:#fff}
.pf-btn-danger{width:36px;height:36px;border-radius:8px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.2);color:#ef4444;font-size:14px;cursor:pointer;display:grid;place-items:center;transition:all .15s}
.pf-btn-danger:hover{background:rgba(239,68,68,0.2)}
.pf-image-hint{font-size:12px;color:rgba(255,255,255,0.3)}
.pf-color-group{display:flex;align-items:center;gap:12px}
.pf-color-presets{display:flex;gap:8px}
.pf-color-preset{cursor:pointer}
.pf-color-preset input{display:none}
.pf-color-preset span{display:block;width:32px;height:32px;border-radius:50%;background:var(--c);border:3px solid transparent;transition:all .15s}
.pf-color-preset input:checked+span{border-color:#fff;box-shadow:0 0 0 2px var(--c)}
.pf-color-picker{width:32px;height:32px;border:none;border-radius:8px;cursor:pointer;background:none;padding:0}
.pf-color-picker::-webkit-color-swatch-wrapper{padding:0}
.pf-color-picker::-webkit-color-swatch{border:2px solid rgba(255,255,255,0.15);border-radius:8px}
.pf-command-row{display:flex;gap:8px;margin-bottom:8px}
.pf-command-row .pf-input{flex:1}
.pf-btn-remove{width:36px;height:36px;border-radius:8px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.2);color:#ef4444;font-size:14px;cursor:pointer;display:grid;place-items:center;flex-shrink:0;transition:all .15s}
.pf-btn-remove:hover{background:rgba(239,68,68,0.2)}
.pf-btn-add-cmd{padding:8px 16px;border-radius:8px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);color:#10B981;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .15s}
.pf-btn-add-cmd:hover{background:rgba(16,185,129,0.18)}
.pf-toggle{display:flex;gap:16px;align-items:flex-start;cursor:pointer;padding:16px;border-radius:12px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);transition:all .15s}
.pf-toggle:hover{border-color:rgba(255,255,255,0.1)}
.pf-toggle input{display:none}
.pf-toggle input:checked~.pf-toggle-slider{background:#10B981;border-color:#10B981}
.pf-toggle input:checked~.pf-toggle-slider::after{transform:translateX(18px)}
.pf-toggle-slider{position:relative;width:40px;height:22px;border-radius:11px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.08);flex-shrink:0;transition:all .2s}
.pf-toggle-slider::after{content:'';position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .2s}
.pf-toggle-title{font-size:14px;font-weight:700;color:#fff;margin-bottom:4px}
.pf-toggle-desc{font-size:12px;color:rgba(255,255,255,0.4);line-height:1.5}
.pf-toggle-desc code{color:#10B981;font-weight:600;background:rgba(16,185,129,0.1);padding:1px 5px;border-radius:4px;font-size:11px}
.pf-footer{display:flex;gap:12px;padding-top:24px;border-top:1px solid rgba(255,255,255,0.06);margin-top:8px}
.pf-save-btn{padding:12px 28px;font-size:14px;border-radius:10px}
@media(max-width:768px){.pf-card{padding:20px 16px}.pf-row{grid-template-columns:1fr}.pf-type-group{grid-template-columns:1fr}}
</style>

<script>
function updateType(el) {
  el.closest('.pf-type-group').querySelectorAll('.pf-type-option').forEach(function(o){ o.classList.remove('active'); });
  el.closest('.pf-type-option').classList.add('active');
}
function selectCategory(el) {
  el.closest('.pf-category-group').querySelectorAll('.pf-cat-option').forEach(function(o){ o.classList.remove('active'); });
  el.closest('.pf-cat-option').classList.add('active');
}
function selectColor(el) {
  el.closest('.pf-color-presets').querySelectorAll('.pf-color-preset').forEach(function(o){ o.classList.remove('active'); });
  el.closest('.pf-color-preset').classList.add('active');
}
function previewImage(input) {
  if (input.files && input.files[0]) {
    var reader = new FileReader();
    reader.onload = function(e) {
      var preview = document.getElementById('image-preview');
      preview.classList.remove('empty');
      preview.innerHTML = '<img src="' + e.target.result + '" id="preview-img">';
    };
    reader.readAsDataURL(input.files[0]);
  }
}
function removeImage() {
  var preview = document.getElementById('image-preview');
  preview.classList.add('empty');
  preview.innerHTML = '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>';
  var existingInput = document.querySelector('input[name=existing_icon]');
  if (existingInput) existingInput.value = '';
  var fileInput = document.getElementById('icon-input');
  fileInput.value = '';
}
function addCommand() {
  var list = document.getElementById('commands-list');
  var row = document.createElement('div');
  row.className = 'pf-command-row';
  row.innerHTML = '<input type="text" name="commands[]" class="pf-input" placeholder="lp user {player} parent add lunar"><button type="button" class="pf-btn-remove" onclick="this.parentElement.remove()">🗑</button>';
  list.appendChild(row);
}
</script>

</div>
</body>
</html>
