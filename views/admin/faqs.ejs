<%- include('layout', { active: 'store', title: 'Витрина / FAQ' }) %>

<div class="page-header">
  <h1>Частые вопросы</h1>
  <a href="/admin/faqs/create" class="btn btn-primary">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
    Добавить
  </a>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Вопрос</th>
        <th>Ответ</th>
        <th>Порядок</th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
      <% if (faqs.length === 0) { %>
      <tr><td colspan="4" class="empty"><p>Нет вопросов.</p></td></tr>
      <% } else { %>
      <% faqs.forEach(function(f) { %>
      <tr>
        <td style="font-weight:600;color:#fff;max-width:250px"><%= f.question.substring(0,60) %></td>
        <td style="color:rgba(255,255,255,0.5);max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= f.answer.substring(0,80) %></td>
        <td style="color:rgba(255,255,255,0.5)"><%= f.sort_order %></td>
        <td>
          <div class="actions">
            <a href="/admin/faqs/edit/<%= f.id %>" class="btn btn-ghost btn-sm">Ред.</a>
            <form method="POST" action="/admin/faqs/delete/<%= f.id %>" style="display:inline" onsubmit="return confirm('Удалить?')">
              <button type="submit" class="btn btn-danger btn-sm">Удал.</button>
            </form>
          </div>
        </td>
      </tr>
      <% }); %>
      <% } %>
    </tbody>
  </table></div>
</div>

</div>
</body>
</html>
