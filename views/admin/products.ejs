<%- include('layout', { active: 'catalog', title: 'Каталог' }) %>

<div class="page-header">
  <h1>Каталог</h1>
  <a href="/admin/products/create" class="btn btn-primary">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
    Добавить товар
  </a>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Товар</th>
        <th>Цена</th>
        <th>Категория</th>
        <th>Статус</th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
      <% if (products.length === 0) { %>
      <tr><td colspan="5" class="empty"><p>Нет товаров. Добавьте первый товар.</p></td></tr>
      <% } else { %>
      <% products.forEach(function(p) { %>
      <tr>
        <td>
          <div style="display:flex;align-items:center;gap:12px">
            <% if (p.icon_url) { %>
            <img src="<%= p.icon_url %>" class="product-img" alt="">
            <% } else { %>
            <div class="product-img" style="display:grid;place-items:center;font-size:16px">📦</div>
            <% } %>
            <div>
              <div style="font-weight:600;color:#fff"><%= p.name %></div>
              <% if (p.description) { %>
              <div style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:2px"><%= p.description.substring(0,50) %></div>
              <% } %>
            </div>
          </div>
        </td>
        <td style="font-weight:700;color:#fff"><%= p.price %> ₽</td>
        <td style="color:rgba(255,255,255,0.5)"><%= p.category_name || '—' %></td>
        <td>
          <% if (p.visible) { %>
          <span class="badge badge-green">Активен</span>
          <% } else { %>
          <span class="badge badge-gray">Скрыт</span>
          <% } %>
        </td>
        <td>
          <div class="actions">
            <a href="/admin/products/edit/<%= p.id %>" class="btn btn-ghost btn-sm">Ред.</a>
            <form method="POST" action="/admin/products/delete/<%= p.id %>" style="display:inline" onsubmit="return confirm('Удалить товар?')">
              <button type="submit" class="btn btn-danger btn-sm">Удал.</button>
            </form>
          </div>
        </td>
      </tr>
      <% }); %>
      <% } %>
    </tbody>
  </table></div>
</div>

</div>
</body>
</html>
