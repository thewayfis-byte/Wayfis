<%- include('layout', { active: 'promos', title: 'Акции и промокоды' }) %>

<div class="page-header">
  <h1>Акции и промокоды</h1>
  <a href="/admin/promos/create" class="btn btn-primary">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
    Создать промокод
  </a>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Код</th>
        <th>Скидка</th>
        <th>Использований</th>
        <th>Лимит</th>
        <th>Срок действия</th>
        <th>Статус</th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
      <% if (promos.length === 0) { %>
        <tr><td colspan="7" class="empty">Промокоды пока не созданы</td></tr>
      <% } else { %>
        <% promos.forEach(promo => { %>
          <tr>
            <td><strong><%= promo.code %></strong></td>
            <td><%= promo.discount_type === 'percent' ? promo.discount_value + '%' : promo.discount_value + ' ₽' %></td>
            <td><%= promo.used_count %></td>
            <td><%= promo.max_uses || '∞' %></td>
            <td><%= promo.expires_at ? new Date(promo.expires_at).toLocaleDateString('ru-RU') : 'Бессрочно' %></td>
            <td><span class="badge <%= promo.active ? 'badge-green' : 'badge-gray' %>"><%= promo.active ? 'Активен' : 'Выкл.' %></span></td>
            <td class="actions">
              <a href="/admin/promos/edit/<%= promo.id %>" class="btn btn-ghost btn-sm">Ред.</a>
              <form method="POST" action="/admin/promos/delete/<%= promo.id %>" style="display:inline" onsubmit="return confirm('Удалить промокод?')">
                <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table></div>
</div>

</div>
</body>
</html>