<%- include('layout', { active: 'servers', title: category ? 'Редактировать категорию' : 'Создать категорию' }) %>

<div class="page-header">
  <h1><%= category ? 'Редактировать категорию' : 'Создать категорию' %></h1>
</div>

<form method="POST" style="max-width:480px">
  <div class="card">
    <div class="card-body">
      <div class="form-group">
        <label>Название *</label>
        <input type="text" name="name" required value="<%= category ? category.name : '' %>">
      </div>
      <div class="form-group">
        <label>Порядок сортировки</label>
        <input type="number" name="sort_order" value="<%= category ? category.sort_order : '0' %>">
      </div>
      <div style="margin-bottom:16px">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:rgba(255,255,255,0.6)">
          <input type="checkbox" name="visible" <%= !category || category.visible ? 'checked' : '' %> style="width:16px;height:16px;accent-color:#10B981">
          Категория видна на сайте
        </label>
      </div>
    </div>
  </div>
  <div style="display:flex;gap:10px;margin-top:16px">
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a href="/admin/categories" class="btn btn-ghost">Отмена</a>
  </div>
</form>

</div>
</body>
</html>
