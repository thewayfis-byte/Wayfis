---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = [
  {
    id: "vpn",
    title: "Telegram VPN Bot + Website",
    desc: "Developed a Telegram bot and website for automatic VPN issuance.",
    fullDesc: "A complete ecosystem for selling VPN services. The bot processes payments via Qiwi/Lava, issues WireGuard configurations. The website serves as a showcase and user's personal account.",
    count: "Qiwi VPN",
    tags: ["Python", "Node.js", "MySQL"],
    link: "https://t.me/your_bot_link",
    screenshots: [
      `${base}/projects/vpn1.jpg`,
      `${base}/projects/vpn2.jpg`,
      `${base}/projects/vpn3.jpg`,
      `${base}/projects/vpn4.jpg`,
      `${base}/projects/vpn5.jpg`,
      `${base}/projects/vpn6.jpg`
    ]
  },
  {
    id: "sites",
    title: "Websites",
    desc: "Landing pages, showcases, and personal accounts.",
    fullDesc: "Development of modern web interfaces with a focus on UX/UI. We use Astro for speed and Tailwind for design flexibility.",
    count: "5 cases",
    tags: ["Astro", "Tailwind", "React"],
    link: "https://wayfis.ru",
    screenshots: [
      `${base}/projects/site1.jpg`,
      `${base}/projects/site2.jpg`
    ]
  }

    function openModal(project: any) {
      currentProject = project;
      currentSlideIndex = 0;
      
      modalTitle!.textContent = project.title;
      modalDesc!.textContent = project.fullDesc;
      totalSlidesEl!.textContent = project.screenshots.length.toString();
      modalLink!.href = project.link;
      modalLink!.style.display = project.link === "#" ? 'none' : 'flex';

      modalTags!.innerHTML = project.tags.map((tag: string) => 
        `<span class="px-3 py-1 bg-accent/10 text-accent rounded-lg text-[10px] font-bold border border-accent/20 uppercase">${tag}</span>`
      ).join('');

      updateSlide();
      modal?.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    }

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentSlideIndex = (currentSlideIndex - 1 + currentProject.screenshots.length) % currentProject.screenshots.length;
      updateSlide();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentSlideIndex = (currentSlideIndex + 1) % currentProject.screenshots.length;
      updateSlide();
    });

    document.querySelectorAll('.open-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        const project = JSON.parse(btn.getAttribute('data-project') || '{}');
        openModal(project);
      });
    });

    document.querySelectorAll('.modal-close').forEach(btn => {
      btn.addEventListener('click', closeModal);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft' && !modal?.classList.contains('opacity-0')) prevBtn?.click();
      if (e.key === 'ArrowRight' && !modal?.classList.contains('opacity-0')) nextBtn?.click();
    });
  </script>

  <Footer />
</Layout>
