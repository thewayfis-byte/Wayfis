---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const categories = [
  {
    title: "Дизайн",
    desc: "Оформление сообществ, логотипы, баннеры, UI и постеры.",
    count: "10 кейсов",
    tags: ["UX/UI", "Дизайн сообществ", "Логотипы", "Прочее"],
    icon: "🎨"
  },
  {
    title: "Видеоролики",
    desc: "Открытия сезонов, тизеры обновлений и ролики под релиз.",
    count: "0 кейсов",
    tags: ["Трейлеры", "Shorts и рилсы", "Анимации"],
    icon: "🎬"
  },
  {
    title: "Сайты",
    desc: "Лендинги, витрины, страницы проекта и личные кабинеты.",
    count: "5 кейсов",
    tags: ["Landing Page", "Dashboard", "E-commerce"],
    icon: "💻"
  }
];
---

<Layout title="Портфолио | Мои работы">
  <Header />
  <main class="pt-32 pb-20">
    <section class="max-w-7xl mx-auto px-6">
      <!-- Hero Header -->
      <div class="relative bg-card rounded-[2.5rem] p-12 md:p-20 overflow-hidden border border-white/5 mb-12">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-accent/20 blur-[100px] -z-10"></div>
        <div class="max-w-2xl">
          <span class="inline-block px-4 py-1.5 rounded-full bg-accent/10 text-accent text-xs font-bold mb-6 border border-accent/20">
            Кейсы MyPortfolio
          </span>
          <h1 class="text-5xl font-bold mb-6">Портфолио</h1>
          <p class="text-textMuted text-lg leading-relaxed">
            Выберите направление, чтобы открыть отдельную страницу категории и посмотреть работы с фото, презентациями и PDF.
          </p>
        </div>
      </div>

      <!-- Categories List -->
      <div class="space-y-6">
        {categories.map(cat => (
          <div class="group relative bg-card rounded-[2rem] p-8 border border-white/5 hover:border-accent/30 transition-all flex flex-col md:flex-row items-center gap-8">
            <div class="w-full md:w-64 aspect-video bg-accent/10 rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform border border-accent/20">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
            </div>            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-xs font-bold text-textMuted bg-white/5 px-3 py-1 rounded-full">{cat.count}</span>
              </div>
              <h3 class="text-3xl font-bold mb-3">{cat.title}</h3>
              <p class="text-textMuted mb-6 max-w-xl">{cat.desc}</p>
              <div class="flex flex-wrap gap-2">
                {cat.tags.map(tag => (
                  <span class="px-4 py-1.5 bg-white/5 rounded-full text-xs font-medium border border-white/5">{tag}</span>
                ))}
              </div>
            </div>
            <button class="px-8 py-3 bg-white/5 hover:bg-white/10 rounded-xl font-bold border border-white/10 transition-all">
              Смотреть
            </button>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
