---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
---

<Layout title="Отзывы | Wayfis">
  <Header />
  <main class="pt-32 pb-20 min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-white to-white/40">
        Раздел в разработке
      </h1>
      <p class="text-textMuted text-lg md:text-xl max-w-2xl mx-auto">
        Мы работаем над этим разделом. Скоро здесь появятся отзывы наших клиентов.
      </p>
      <div class="mt-10">
        <a href="/" class="inline-flex items-center justify-center px-8 py-3 rounded-full bg-white text-black font-medium hover:bg-opacity-90 transition-all">
          На главную
        </a>
      </div>
    </div>
  </main>  <Footer />
</Layout>
