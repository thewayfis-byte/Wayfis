---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

import Vpn1 from '../assets/projects/Vpn1.jpg';
import Vpn2 from '../assets/projects/Vpn2.jpg';
import Vpn3 from '../assets/projects/Vpn3.jpg';
import Vpn4 from '../assets/projects/Vpn4.jpg';
import Vpn5 from '../assets/projects/Vpn5.jpg';
import Vpn6 from '../assets/projects/Vpn6.jpg';
import Romus1 from '../assets/projects/Romus1.jpg';
import Romus2 from '../assets/projects/Romus2.jpg';
import Romus3 from '../assets/projects/Romus3.jpg';
import Romus4 from '../assets/projects/Romus4.jpg';

const lang = getLangFromUrl(Astro.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tagColors = ['text-green-400', 'text-yellow-400', 'text-blue-400', 'text-purple-400'];

const categories = [
  {
    id: "vpn",
    file: "case_01.py",
    title: "Telegram VPN Бот + Сайт",
    fn: "vpn_ecosystem()",
    desc: "Разработали Telegram-бота и сайт для автоматической выдачи VPN.",
    fullDesc: "Полноценная экосистема для продажи VPN-услуг. Бот обрабатывает платежи через Qiwi/Lava, выдает конфигурации WireGuard. Сайт служит витриной и личным кабинетом пользователя.",
    label: "Qiwi VPN",
    tags: ["Python", "Node.js", "MySQL"],
    link: "https://t.me/your_bot_link",
    screenshots: [Vpn1.src, Vpn2.src, Vpn3.src, Vpn4.src, Vpn5.src, Vpn6.src]
  },
  {
    id: "sites",
    file: "case_02.astro",
    title: "Сайт визитка - Romus site",
    fn: "web_interfaces()",
    desc: "Современный сайт-портфолио",
    fullDesc: "Доработка сайта-визитки, добавили уникальное звуковое сопровождение, плавные анимации, доработали интерфейс с внимание к деталям и продуманный интерфейс.",
    count: "Romus site",
    tags: ["Astro", "TypeScript", "JavaScript", "MDX", "CSS"],
    link: "https://thatromus.github.io/romus-site/",
    screenshots: [Romus1.src, Romus2.src, Romus3.src, Romus4.src]
  }
];
---

<Layout title="Портфолио | Wayfis">
  <Header />

  <main class="pt-32 pb-20">
    <section class="max-w-[1600px] mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 md:mb-16 gap-6">
        <div class="max-w-2xl">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black mb-4 md:mb-6 tracking-tight font-mono">
            <span class="text-accent">const</span> portfolio = [];
          </h1>
          <p class="text-textMuted text-base md:text-lg font-mono">
            // Реализованные проекты, которыми мы гордимся
          </p>
        </div>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 text-accent text-xs font-bold border border-white/10 backdrop-blur-md font-mono">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          {categories.length} кейса
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {categories.map((category) => (
          <article class="bg-card p-8 md:p-10 rounded-[2.5rem] border border-white/5 hover:border-accent/30 transition-all group relative overflow-hidden font-mono">
            <div class="absolute top-4 right-8 text-[10px] text-white/10 uppercase tracking-widest">{category.file}</div>

            <div class="bg-card/60 rounded-2xl border border-white/5 overflow-hidden mb-6 md:mb-8 group-hover:border-accent/20 transition-colors">
              <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-white/[0.02]">
                <div class="w-2.5 h-2.5 rounded-full bg-red-500/50"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/50"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-green-500/50"></div>
                <span class="ml-2 text-[10px] text-white/20 truncate">{category.label}</span>
              </div>
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={category.screenshots[0]}
                  alt={category.title}
                  class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-card/80 via-transparent to-transparent pointer-events-none"></div>
              </div>
            </div>

            <div class="flex items-start justify-between gap-4 mb-4">
              <h2 class="text-xl md:text-2xl font-bold text-white leading-snug">
                <span class="text-accent">export</span> {category.fn}
              </h2>
              <span class="text-[10px] px-2 py-1 bg-accent/10 text-accent rounded-lg border border-accent/20 shrink-0 uppercase tracking-wider">
                {category.label}
              </span>
            </div>

            <p class="text-textMuted text-sm md:text-base mb-6 leading-relaxed">
              <span class="text-purple-400">return</span> "{category.desc}"
            </p>

            <div class="flex flex-wrap gap-2 mb-8">
              {category.tags.map((tag, i) => (
                <span class={`px-3 py-1.5 bg-white/5 rounded-xl text-xs font-bold border border-white/5 ${tagColors[i % tagColors.length]}`}>
                  "{tag}"
                </span>
              ))}
            </div>

            <button
              class="open-modal w-full px-6 py-4 bg-white/5 hover:bg-accent/10 text-white hover:text-accent rounded-2xl border border-white/10 hover:border-accent/30 transition-all font-bold flex items-center justify-center gap-2 group/btn"
              data-project={JSON.stringify(category)}
            >
              open_case()
              <svg class="group-hover/btn:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </article>
        ))}
      </div>
    </section>
  </main>

  <div id="modal" class="fixed inset-0 bg-dark/90 backdrop-blur-xl z-50 opacity-0 pointer-events-none transition-all duration-300 flex items-center justify-center p-3 md:p-6">
    <div class="max-w-7xl w-full max-h-[95vh] bg-card rounded-[2rem] md:rounded-[2.5rem] border border-white/10 overflow-hidden shadow-2xl flex flex-col">
      <div class="flex justify-between items-center px-5 md:px-8 py-4 border-b border-white/5 shrink-0">
        <div>
          <p class="text-[10px] text-white/30 uppercase tracking-widest font-mono mb-1" id="modal-file"></p>
          <h3 id="modal-title" class="text-lg md:text-2xl font-bold text-white font-mono"></h3>
        </div>
        <button class="modal-close w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 hover:bg-white/10 text-textMuted hover:text-white transition-all text-2xl leading-none border border-white/5">&times;</button>
      </div>

      <div class="flex-1 min-h-0 overflow-y-auto p-4 md:p-6">
        <div class="bg-card/60 rounded-2xl border border-white/5 overflow-hidden mb-4">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500/50"></div>
            <p class="ml-2 text-xs text-textMuted font-mono">
              slide[<span id="current-slide">1</span>/<span id="total-slides"></span>]
            </p>
          </div>
          <div class="relative flex items-center justify-center bg-card/80 min-h-[50vh] md:min-h-[60vh]">
            <img id="modal-image" src="" alt="" class="w-full h-auto max-h-[65vh] object-contain">
            <button id="prev-slide" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center bg-card/80 hover:bg-accent/80 text-white rounded-xl border border-white/10 transition-all backdrop-blur-sm">
              ←
            </button>
            <button id="next-slide" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center bg-card/80 hover:bg-accent/80 text-white rounded-xl border border-white/10 transition-all backdrop-blur-sm">
              →
            </button>
          </div>
        </div>

        <div class="flex flex-col md:flex-row md:items-end gap-4 md:gap-8 font-mono">
          <div class="flex-1">
            <p id="modal-desc" class="text-textMuted text-sm md:text-base leading-relaxed mb-4"></p>
            <div id="modal-tags" class="flex flex-wrap gap-2"></div>
          </div>
          <a id="modal-link" href="#" target="_blank" class="shrink-0 inline-flex items-center justify-center gap-2 px-6 py-4 bg-accent hover:bg-accent-hover text-white rounded-2xl transition-all font-bold shadow-[0_0_30px_rgba(59,130,246,0.2)] hover:shadow-[0_0_40px_rgba(59,130,246,0.4)]">
            visit_project()
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script define:vars={{ tagColors }}>
  let currentProject = null;
  let currentSlideIndex = 0;

  const modal = document.getElementById('modal');
  const modalFile = document.getElementById('modal-file');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalTags = document.getElementById('modal-tags');
  const modalLink = document.getElementById('modal-link');
  const modalImage = document.getElementById('modal-image');
  const totalSlidesEl = document.getElementById('total-slides');
  const currentSlideEl = document.getElementById('current-slide');
  const prevBtn = document.getElementById('prev-slide');
  const nextBtn = document.getElementById('next-slide');

  function updateSlide() {
    if (!modalImage || !currentProject || !currentSlideEl) return;
    modalImage.src = currentProject.screenshots[currentSlideIndex];
    currentSlideEl.textContent = (currentSlideIndex + 1).toString();
  }

  function openModal(project) {
    currentProject = project;
    currentSlideIndex = 0;

    if (modalFile) modalFile.textContent = project.file || 'case.ts';
    if (modalTitle) modalTitle.innerHTML = `<span class="text-accent">export</span> ${project.fn || project.title}`;
    if (modalDesc) modalDesc.textContent = project.fullDesc;
    if (totalSlidesEl) totalSlidesEl.textContent = project.screenshots.length.toString();
    if (currentSlideEl) currentSlideEl.textContent = '1';
    if (modalLink) {
      modalLink.href = project.link;
      modalLink.style.display = project.link && project.link !== '#' ? 'inline-flex' : 'none';
    }

    if (modalTags) {
      modalTags.innerHTML = project.tags.map((tag, i) =>
        `<span class="px-3 py-1.5 bg-white/5 rounded-xl text-xs font-bold border border-white/5 ${tagColors[i % tagColors.length]}">"${tag}"</span>`
      ).join('');
    }

    updateSlide();
    if (modal) modal.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (modal) modal.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentProject) {
      currentSlideIndex = (currentSlideIndex - 1 + currentProject.screenshots.length) % currentProject.screenshots.length;
      updateSlide();
    }
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentProject) {
      currentSlideIndex = (currentSlideIndex + 1) % currentProject.screenshots.length;
      updateSlide();
    }
  });

  document.querySelectorAll('.open-modal').forEach(btn => {
    btn.addEventListener('click', () => {
      const projectData = btn.getAttribute('data-project');
      if (projectData) openModal(JSON.parse(projectData));
    });
  });

  document.querySelectorAll('.modal-close').forEach(btn => {
    btn.addEventListener('click', closeModal);
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft' && modal && !modal.classList.contains('opacity-0')) {
      e.preventDefault();
      prevBtn?.click();
    }
    if (e.key === 'ArrowRight' && modal && !modal.classList.contains('opacity-0')) {
      e.preventDefault();
      nextBtn?.click();
    }
  });
</script>
