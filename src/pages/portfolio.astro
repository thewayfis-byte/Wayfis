---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    id: "vpn",
    title: "Telegram VPN Бот + Сайт",
    desc: "Разработали Telegram-бота и сайт для автоматической выдачи VPN.",
    fullDesc: "Полноценная экосистема для продажи VPN-услуг. Бот обрабатывает платежи через Crypto Bot/Platega, выдает конфигурации через X3-UI. Сайт служит витриной и личным кабинетом пользователя.",
    count: "Qiwi VPN",
    tags: ["Python", "Node.js", "MySQL"],
    link: "https://t.me/qiwivpn_xbot",
    screenshots: [
      "/Wayfis/projects/vpn1.jpg",
      "/Wayfis/projects/vpn2.jpg",
      "/Wayfis/projects/vpn3.jpg",
      "/Wayfis/projects/vpn4.jpg",
      "/Wayfis/projects/vpn5.jpg",
      "/Wayfis/projects/vpn6.jpg"            
    ]  },
  {
    id: "sites",
    title: "Сайты",
    desc: "Лендинги, витрины и личные кабинеты.",
    fullDesc: "Разработка современных веб-интерфейсов с упором на UX/UI. Используем Astro для скорости и Tailwind для гибкости дизайна.",
    count: "5 кейсов",
    tags: ["Astro", "Tailwind", "React"],
    link: "https://wayfis.ru",
    screenshots: [
      "/Wayfis/projects/site-1.jpg",
      "/Wayfis/projects/site-2.jpg"
    ]
  }
];
---

<Layout title="Портфолио | Мои работы">
  <Header />
  <main class="pt-32 pb-20">
    <section class="max-w-7xl mx-auto px-6">
      <div class="relative bg-card rounded-[2.5rem] p-12 md:p-20 overflow-hidden border border-white/5 mb-12">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-accent/20 blur-[100px] -z-10"></div>
        <div class="max-w-2xl">
          <h1 class="text-5xl font-bold mb-6">Портфолио</h1>
          <p class="text-textMuted text-lg leading-relaxed">
            Нажмите «Смотреть», чтобы полистать скриншоты и изучить детали проектов.
          </p>
        </div>
      </div>

      <div class="space-y-6">
        {categories.map(cat => (
          <div class="group relative bg-card rounded-[2rem] p-8 border border-white/5 hover:border-accent/30 transition-all flex flex-col md:flex-row items-center gap-8">
            <div class="w-full md:w-64 aspect-video bg-accent/10 rounded-2xl overflow-hidden border border-accent/20">
              <img src={cat.screenshots[0]} alt={cat.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
            </div>
            <div class="flex-1">
              <h3 class="text-3xl font-bold mb-3">{cat.title}</h3>
              <p class="text-textMuted mb-6 max-w-xl">{cat.desc}</p>
              <div class="flex flex-wrap gap-2">
                {cat.tags.map(tag => (
                  <span class="px-4 py-1.5 bg-white/5 rounded-full text-xs font-medium border border-white/5">{tag}</span>
                ))}
              </div>
            </div>
            <button 
              class="open-modal px-8 py-3 bg-accent hover:bg-accent-hover text-white rounded-xl font-bold transition-all shadow-lg shadow-accent/20"
              data-project={JSON.stringify(cat)}
            >
              Смотреть
            </button>
          </div>
        ))}
      </div>
    </section>
  </main>

  <!-- Modal Structure -->
  <div id="project-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300">
    <div class="absolute inset-0 bg-dark/95 backdrop-blur-md modal-close"></div>
    <div class="relative bg-card border border-white/10 w-full max-w-5xl max-h-[95vh] overflow-y-auto rounded-[2.5rem] shadow-2xl">
      <button class="absolute top-6 right-6 text-white bg-black/50 p-2 rounded-full hover:bg-accent transition-colors modal-close z-50">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      
      <div class="flex flex-col lg:flex-row">
        <!-- Slider Area -->
        <div class="lg:w-2/3 relative bg-black/20 aspect-video flex items-center justify-center group">
          <img id="modal-image" src="" alt="" class="w-full h-full object-contain" />
          
          <!-- Navigation Arrows -->
          <button id="prev-slide" class="absolute left-4 p-3 rounded-full bg-black/50 text-white hover:bg-accent transition-all opacity-0 group-hover:opacity-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button id="next-slide" class="absolute right-4 p-3 rounded-full bg-black/50 text-white hover:bg-accent transition-all opacity-0 group-hover:opacity-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>

          <!-- Counter -->
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-black/50 text-white text-xs font-bold font-mono">
            <span id="current-index">1</span> / <span id="total-slides">1</span>
          </div>
        </div>

        <!-- Info Area -->
        <div class="lg:w-1/3 p-8 md:p-10 flex flex-col border-l border-white/5">
          <div id="modal-tags" class="flex flex-wrap gap-2 mb-6"></div>
          <h2 id="modal-title" class="text-3xl font-bold mb-4"></h2>
          <p id="modal-desc" class="text-textMuted leading-relaxed mb-8 flex-1"></p>
          
          <div class="flex flex-col gap-3">
            <a id="modal-link" href="#" target="_blank" class="w-full py-4 bg-accent hover:bg-accent-hover text-white rounded-2xl font-bold transition-all flex items-center justify-center gap-3">
              Посетить сайт <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentProject: any = null;
    let currentSlideIndex = 0;

    const modal = document.getElementById('project-modal');
    const modalImage = document.getElementById('modal-image') as HTMLImageElement;
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    const modalTags = document.getElementById('modal-tags');
    const modalLink = document.getElementById('modal-link') as HTMLAnchorElement;
    const currentIndexEl = document.getElementById('current-index');
    const totalSlidesEl = document.getElementById('total-slides');
    
    const prevBtn = document.getElementById('prev-slide');
    const nextBtn = document.getElementById('next-slide');

    function updateSlide() {
      if (!currentProject) return;
      modalImage.src = currentProject.screenshots[currentSlideIndex];
      currentIndexEl!.textContent = (currentSlideIndex + 1).toString();
    }

    function openModal(project: any) {
      currentProject = project;
      currentSlideIndex = 0;
      
      modalTitle!.textContent = project.title;
      modalDesc!.textContent = project.fullDesc;
      totalSlidesEl!.textContent = project.screenshots.length.toString();
      modalLink!.href = project.link;
      modalLink!.style.display = project.link === "#" ? 'none' : 'flex';

      modalTags!.innerHTML = project.tags.map((tag: string) => 
        `<span class="px-3 py-1 bg-accent/10 text-accent rounded-lg text-[10px] font-bold border border-accent/20 uppercase">${tag}</span>`
      ).join('');

      updateSlide();
      modal?.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    }

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentSlideIndex = (currentSlideIndex - 1 + currentProject.screenshots.length) % currentProject.screenshots.length;
      updateSlide();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentSlideIndex = (currentSlideIndex + 1) % currentProject.screenshots.length;
      updateSlide();
    });

    document.querySelectorAll('.open-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        const project = JSON.parse(btn.getAttribute('data-project') || '{}');
        openModal(project);
      });
    });

    document.querySelectorAll('.modal-close').forEach(btn => {
      btn.addEventListener('click', closeModal);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft' && !modal?.classList.contains('opacity-0')) prevBtn?.click();
      if (e.key === 'ArrowRight' && !modal?.classList.contains('opacity-0')) nextBtn?.click();
    });
  </script>

  <Footer />
</Layout>
  <Footer />
</Layout>
