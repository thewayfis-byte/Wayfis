---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import laptop from '../image/laptop.png';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Wayfis | Разработка сайтов и ботов">	<Header />
	
	<main class="pt-32">
		<!-- Hero Section -->
		<section class="max-w-[1600px] mx-auto px-6 mb-20">
			<div class="relative bg-card rounded-[2rem] p-8 md:p-20 md:py-16 overflow-hidden border border-white/5 shadow-2xl">				<!-- Background Glow -->
				<div class="absolute top-[-20%] right-[-10%] w-[60%] h-[140%] bg-accent/10 blur-[120px] -z-10 rotate-12"></div>
				<div class="absolute bottom-[-20%] left-[-10%] w-[40%] h-[100%] bg-blue-600/5 blur-[100px] -z-10"></div>
				
				<div class="max-w-3xl relative z-10">
					<span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 text-accent text-xs font-bold mb-8 border border-white/10 backdrop-blur-md">
						<span class="relative flex h-2 w-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
						</span>
						Разработчик Wayfis
					</span>
					<h1 class="text-4xl sm:text-6xl md:text-8xl font-black mb-6 md:mb-8 leading-[1.1] tracking-tight">
						Создаю <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-blue-400">цифровое</span> будущее
					</h1>
					<p class="text-textMuted text-lg md:text-xl mb-8 md:mb-12 max-w-xl leading-relaxed font-medium">
						Профессиональная разработка экосистем: от высоконагруженных ботов до премиальных веб-интерфейсов.
					</p>					
					<div class="flex flex-col sm:flex-row gap-4 md:gap-6">
						<a href={`${base}/catalog`} class="px-8 md:px-10 py-4 md:py-5 bg-accent hover:bg-accent-hover text-white rounded-2xl font-bold transition-all flex items-center justify-center gap-3 shadow-[0_0_30px_rgba(59,130,246,0.3)] hover:shadow-[0_0_40px_rgba(59,130,246,0.5)] hover:-translate-y-1 text-center">
							Начать проект <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
						</a>
						<a href={`${base}/portfolio`} class="px-8 md:px-10 py-4 md:py-5 bg-white/5 hover:bg-white/10 text-white rounded-2xl font-bold border border-white/10 transition-all backdrop-blur-sm hover:-translate-y-1 text-center">
							Кейсы
						</a>
					</div>				</div>
				<!-- Abstract Decoration -->
				<div class="hidden lg:block absolute right-0 top-0 w-1/2 h-full pointer-events-none">
					<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] border border-white/5 rounded-full"></div>
					<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] border border-white/5 rounded-full"></div>
					<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-accent/5 blur-3xl rounded-full"></div>
					<img src={laptop.src} alt="Laptop" class="absolute top-1/2 left-[45%] -translate-x-1/2 -translate-y-1/2 w-[80%] h-auto object-contain z-20 drop-shadow-[0_0_50px_rgba(59,130,246,0.2)] animate-float" />
				</div>
			</div>
		</section>

<style>
	@keyframes float {
		0%, 100% { transform: translate(-50%, -52%); }
		50% { transform: translate(-50%, -48%); }
	}
	.animate-float {
		animation: float 6s ease-in-out infinite;
	}
</style>
		<!-- Stats Section -->
		<section class="max-w-[1600px] mx-auto px-6 mb-40">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-12 font-mono">
					<div class="relative group p-8 md:p-10 md:py-14 bg-card/50 rounded-[2rem] border border-white/5 hover:border-accent/20 transition-all overflow-hidden">
						<div class="absolute top-2 right-4 text-[10px] text-white/5">const projects: number</div>
						<div class="text-5xl md:text-6xl font-black mb-4 text-white group-hover:text-accent transition-colors">100+</div>
						<div class="text-textMuted uppercase tracking-[0.2em] text-[10px] md:text-xs font-black">// Проектов запущено</div>
					</div>
					<div class="relative group p-8 md:p-10 md:py-14 bg-card/50 rounded-[2rem] border border-white/5 hover:border-accent/20 transition-all overflow-hidden">
						<div class="absolute top-2 right-4 text-[10px] text-white/5">const hours: string</div>
						<div class="text-5xl md:text-6xl font-black mb-4 text-white group-hover:text-accent transition-colors">1000+</div>
						<div class="text-textMuted uppercase tracking-[0.2em] text-[10px] md:text-xs font-black">// Часов разработки</div>
					</div>
					<div class="relative group p-8 md:p-10 md:py-14 bg-card/50 rounded-[2rem] border border-white/5 hover:border-accent/20 transition-all overflow-hidden sm:col-span-2 md:col-span-1">
						<div class="absolute top-2 right-4 text-[10px] text-white/5">const experience: number</div>
						<div class="text-5xl md:text-6xl font-black mb-4 text-white group-hover:text-accent transition-colors">3+</div>
						<div class="text-textMuted uppercase tracking-[0.2em] text-[10px] md:text-xs font-black">// Года на рынке</div>
					</div>
				</div>		</section>
		<!-- Services Section -->
		<section id="services" class="max-w-[1600px] mx-auto px-6 mb-40">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 md:mb-16 gap-6">
				<div class="max-w-2xl">
					<h2 class="text-3xl sm:text-4xl md:text-5xl font-black mb-4 md:mb-6 tracking-tight font-mono"><span class="text-accent">class</span> Services {}</h2>
					<p class="text-textMuted text-base md:text-lg font-mono">// Я не просто пишу код, я создаю инструменты для масштабирования вашего бизнеса.</p>
				</div>				<a href={`${base}/catalog`} class="group flex items-center gap-3 text-accent font-bold text-base md:text-lg font-mono">
					get_all_services() <svg class="group-hover:translate-x-2 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
				</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
				<div class="bg-card p-8 md:p-12 rounded-[2.5rem] md:rounded-[3rem] border border-white/5 hover:border-accent/30 transition-all group relative overflow-hidden font-mono">
					<div class="absolute top-4 right-8 text-[10px] text-white/10 uppercase tracking-widest">service_01.ts</div>
					<div class="w-14 h-14 md:w-16 md:h-16 bg-accent/10 rounded-2xl flex items-center justify-center text-accent mb-6 md:mb-8 group-hover:scale-110 transition-transform border border-accent/20">
						<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
					</div>
					<h3 class="text-2xl md:text-3xl font-bold mb-4 text-white"><span class="text-accent">public</span> web_dev()</h3>
					<p class="text-textMuted text-base md:text-lg mb-8 leading-relaxed">
						<span class="text-purple-400">return</span> "Создание высокопроизводительных интерфейсов, которые влюбляют пользователей в ваш продукт.";
					</p>
					<div class="flex flex-wrap gap-3">
						<span class="px-4 py-2 bg-white/5 rounded-xl text-xs font-bold border border-white/5 text-green-400">"React"</span>
						<span class="px-4 py-2 bg-white/5 rounded-xl text-xs font-bold border border-white/5 text-green-400">"Next.js"</span>
						<span class="px-4 py-2 bg-white/5 rounded-xl text-xs font-bold border border-white/5 text-green-400">"Astro"</span>
					</div>
				</div>

				<div class="bg-card p-8 md:p-12 rounded-[2.5rem] md:rounded-[3rem] border border-white/5 hover:border-accent/30 transition-all group relative overflow-hidden font-mono">
					<div class="absolute top-4 right-8 text-[10px] text-white/10 uppercase tracking-widest">service_02.py</div>
					<div class="w-14 h-14 md:w-16 md:h-16 bg-accent/10 rounded-2xl flex items-center justify-center text-accent mb-6 md:mb-8 group-hover:scale-110 transition-transform border border-accent/20">
						<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
					</div>
					<h3 class="text-2xl md:text-3xl font-bold mb-4 text-white"><span class="text-accent">def</span> automation_bots():</h3>
					<p class="text-textMuted text-base md:text-lg mb-8 leading-relaxed">
						<span class="text-purple-400">yield</span> "Разработка сложных алгоритмов автоматизации и Telegram-экосистем любой сложности."
					</p>
					<div class="flex flex-wrap gap-3">
						<span class="px-4 py-2 bg-white/5 rounded-xl text-xs font-bold border border-white/5 text-yellow-400">"Python"</span>
						<span class="px-4 py-2 bg-white/5 rounded-xl text-xs font-bold border border-white/5 text-yellow-400">"Node.js"</span>
						<span class="px-4 py-2 bg-white/5 rounded-xl text-xs font-bold border border-white/5 text-yellow-400">"PostgreSQL"</span>
					</div>
				</div>
			</div>
		</section>
		<!-- About Section -->
		<section id="about" class="max-w-[1600px] mx-auto px-6 mb-40">
			<div class="bg-card rounded-[2.5rem] md:rounded-[4rem] p-8 md:p-24 border border-white/5 flex flex-col xl:flex-row gap-12 md:gap-20 items-center relative overflow-hidden">
				<div class="absolute bottom-0 right-0 w-full h-1/2 bg-gradient-to-t from-accent/5 to-transparent -z-10"></div>
				<div class="w-full flex-1 font-mono text-xs md:text-sm">
					<div class="bg-black/40 p-6 md:p-8 rounded-3xl border border-white/5 backdrop-blur-sm overflow-x-auto">
						<div class="flex gap-2 mb-6">
							<div class="w-3 h-3 rounded-full bg-red-500/50"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
							<div class="w-3 h-3 rounded-full bg-green-500/50"></div>
						</div>
						<pre class="text-accent"><span class="text-purple-400">const</span> <span class="text-yellow-400">developer</span> = &#123;</pre>
						<pre class="pl-4 text-white">  name: <span class="text-green-400">"Wayfis"</span>,</pre>
						<pre class="pl-4 text-white">  role: <span class="text-green-400">"Fullstack Developer"</span>,</pre>
						<pre class="pl-4 text-white">  skills: [<span class="text-green-400">"C++"</span>, <span class="text-green-400">"Java"</span>, <span class="text-green-400">"Python"</span>, <span class="text-green-400">"Rust"</span>, <span class="text-green-400">"Node.js"</span>, <span class="text-green-400">"Astro"</span>],</pre>
						<pre class="pl-4 text-white">  mission: <span class="text-green-400">"Building premium digital products"</span>,</pre>
						<pre class="pl-4 text-white">  status: <span class="text-green-400">"Open for new projects"</span></pre>
						<pre class="text-accent">&#125;;</pre>
					</div>
				</div>
				<div class="flex-1">
					<h2 class="text-3xl sm:text-4xl md:text-5xl font-black mb-6 md:mb-8 tracking-tight font-mono"><span class="text-accent">0x01</span>. Обо мне</h2>
					<p class="text-textMuted text-lg md:text-xl leading-relaxed mb-8 md:mb-10 font-medium">
						Я - независимый разработчик, увлеченный созданием безупречных цифровых продуктов. Мой подход исключает компромиссы между красотой и производительностью.
					</p>
					<div class="flex flex-wrap gap-x-8 md:gap-x-12 gap-y-8">
						<div class="flex gap-4 md:gap-5 group min-w-[200px] flex-1">
							<div class="w-10 h-10 md:w-12 md:h-12 bg-accent/10 rounded-xl flex-shrink-0 flex items-center justify-center text-accent border border-accent/20 group-hover:bg-accent group-hover:text-white transition-all">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
							</div>
							<div class="max-w-[280px]">
								<h5 class="font-bold text-lg md:text-xl mb-1 md:mb-2 text-white font-mono">Support.init()</h5>
								<p class="text-xs md:text-sm text-textMuted leading-relaxed">Я всегда на связи и сопровождаю проект на всех этапах после релиза.</p>
							</div>
						</div>
						<div class="flex gap-4 md:gap-5 group min-w-[200px] flex-1">
							<div class="w-10 h-10 md:w-12 md:h-12 bg-accent/10 rounded-xl flex-shrink-0 flex items-center justify-center text-accent border border-accent/20 group-hover:bg-accent group-hover:text-white transition-all">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
							</div>
							<div class="max-w-[280px]">
								<h5 class="font-bold text-lg md:text-xl mb-1 md:mb-2 text-white font-mono">Security.check()</h5>
								<p class="text-xs md:text-sm text-textMuted leading-relaxed">Использую лучшие практики защиты данных и написания чистого кода.</p>
							</div>
						</div>
					</div>				</div>						
		</section>
	<Footer />
</Layout>
