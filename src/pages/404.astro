---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, getLangPrefix } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const prefix = getLangPrefix(lang);
---

<Layout title={lang === 'ru' ? '404 | Wayfis' : '404 | Wayfis'}>
  <Header />
  <main class="pt-32 pb-20 min-h-[70vh] flex items-center justify-center px-6">
    <section class="max-w-xl text-center font-mono">
      <p class="text-accent text-6xl md:text-8xl font-black mb-4">404</p>
      <h1 class="text-2xl md:text-3xl font-bold mb-4 text-white">
        {lang === 'ru' ? 'Страница не найдена' : 'Page not found'}
      </h1>
      <p class="text-textMuted mb-8">
        {lang === 'ru'
          ? '// Запрошенный маршрут не существует или был перемещён.'
          : '// The requested route does not exist or has been moved.'}
      </p>
      <a href={`${prefix}/`} class="inline-flex items-center gap-2 px-8 py-4 bg-accent hover:bg-accent-hover text-white rounded-2xl font-bold transition-all">
        {lang === 'ru' ? 'На главную' : 'Back to home'}
      </a>
    </section>
  </main>
  <Footer />
</Layout>
