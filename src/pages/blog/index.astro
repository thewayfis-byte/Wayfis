---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ id }) => {
	return !id.startsWith('en-');
})).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);---

<Layout title="Блог | Wayfis Новости">
	<Header />
	<main class="pt-24 md:pt-32 pb-12 md:pb-20">
		<div class="max-w-6xl mx-auto px-4 sm:px-6">
			<div class="mb-10 md:mb-16">
				<h1 class="text-4xl sm:text-5xl md:text-7xl font-black mb-4 md:mb-6 tracking-tight">Блог <span class="text-accent">_</span></h1>
				<p class="text-textMuted text-lg md:text-xl max-w-2xl leading-relaxed">Последние новости, статьи и обновления из мира Wayfis.</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
				{posts.map((post) => (
					<article class="bg-card border border-white/5 rounded-[2rem] overflow-hidden hover:border-accent/30 transition-all group flex flex-col">
						{post.data.image && (
							<div class="aspect-video overflow-hidden">
								<img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
							</div>
						)}
						<div class="p-8 flex flex-col flex-1">
							<div class="flex items-center gap-4 mb-4 text-xs font-mono text-textMuted">
								<span>{post.data.pubDate.toLocaleDateString('ru-RU')}</span>
								<span class="w-1 h-1 rounded-full bg-accent"></span>
								<span class="text-accent">{post.data.tags[0]}</span>
							</div>
							<h2 class="text-2xl font-bold mb-4 group-hover:text-accent transition-colors">{post.data.title}</h2>
							<p class="text-textMuted text-sm mb-8 line-clamp-3">{post.data.description}</p>
							<div class="mt-auto">
								<a href={`/blog/${post.slug}`} class="inline-flex items-center gap-2 text-white font-bold hover:gap-4 transition-all">
									Подробнее <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
								</a>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</main>
	<Footer />
</Layout>
