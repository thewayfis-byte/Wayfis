---
import { reviewsContent } from '../data/reviews';
import { getLangFromUrl, getLangPrefix } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as 'ru' | 'en';
const content = reviewsContent[lang];
const homeUrl = getLangPrefix(lang);

const average = (
  content.reviews.reduce((sum, review) => sum + review.rating, 0) / content.reviews.length
).toFixed(1);
---

<section class="max-w-7xl mx-auto px-6">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
    <div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black mb-4 tracking-tight font-mono">
        <span class="text-accent">const</span> reviews = [];
      </h1>
      <p class="text-textMuted font-mono">// {content.subtitle}</p>
    </div>
    <div class="bg-card rounded-2xl px-6 py-4 border border-white/5 font-mono">
      <p class="text-[10px] text-textMuted uppercase tracking-widest mb-1">{content.averageLabel}</p>
      <p class="text-3xl font-black text-white">{average} <span class="text-accent text-lg">/ 5</span></p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 reveal-stagger">
    {content.reviews.map((review) => (
      <article class="bg-card rounded-[2rem] p-6 md:p-8 border border-white/5 hover:border-accent/20 transition-all font-mono flex flex-col card-hover-lift">
        <div class="flex items-start justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent text-xs font-bold">
              {review.avatar}
            </div>
            <div>
              <h3 class="font-bold text-white">{review.author}</h3>
              <p class="text-[11px] text-textMuted">{review.date}</p>
            </div>
          </div>
          <div class="flex gap-0.5" aria-label={`${review.rating}/5`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <span class={i < review.rating ? 'text-accent' : 'text-white/10'}>★</span>
            ))}
          </div>
        </div>

        <p class="text-xs text-accent mb-3">{review.product}</p>
        <p class="text-textMuted text-sm leading-relaxed flex-1">"{review.content}"</p>
      </article>
    ))}
  </div>

  <div class="mt-12 text-center">
    <a href={homeUrl} class="inline-flex items-center gap-2 px-8 py-4 bg-white/5 hover:bg-white/10 text-white rounded-2xl font-bold border border-white/10 transition-all font-mono">
      {lang === 'ru' ? 'На главную' : 'Back to home'}
    </a>
  </div>
</section>
