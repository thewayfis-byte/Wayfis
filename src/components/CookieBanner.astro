---
const COOKIE_KEY = 'wayfis-cookie-consent';
---

<div id="cookie-banner" class="fixed bottom-6 left-0 right-0 z-[100] px-4 pointer-events-none opacity-0 translate-y-4 transition-all duration-500">
  <div class="max-w-2xl mx-auto bg-card border border-white/10 rounded-2xl p-5 md:p-6 shadow-2xl pointer-events-auto font-mono">
    <p class="text-sm text-textMuted mb-4 leading-relaxed cookie-text"></p>
    <div class="flex flex-col sm:flex-row gap-3">
      <button id="cookie-accept" class="px-6 py-3 bg-accent hover:bg-accent-hover text-white rounded-xl font-bold text-sm transition-all">
        OK
      </button>
      <a id="cookie-policy-link" href="#" class="px-6 py-3 bg-white/5 hover:bg-white/10 text-white rounded-xl border border-white/10 text-sm text-center transition-all">
        policy
      </a>
    </div>
  </div>
</div>

<script define:vars={{ COOKIE_KEY }}>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const policyLink = document.getElementById('cookie-policy-link');
  const textEl = banner?.querySelector('.cookie-text');

  const isEn = window.location.pathname.includes('/en/') || window.location.pathname.endsWith('/en');
  const base = document.querySelector('link[rel="icon"]')?.getAttribute('href')?.replace('/favicon.svg', '') || '';
  const prefix = isEn ? `${base}/en` : base;

  if (textEl) {
    textEl.textContent = isEn
      ? 'We use essential cookies to improve site performance. By continuing, you agree to our Cookie Policy.'
      : 'Мы используем необходимые cookie для корректной работы сайта. Продолжая, вы соглашаетесь с Политикой cookie.';
  }

  if (policyLink) policyLink.href = `${prefix}/cookies`;
  if (acceptBtn) acceptBtn.textContent = isEn ? 'Accept' : 'Принять';

  if (!localStorage.getItem(COOKIE_KEY) && banner) {
    requestAnimationFrame(() => {
      banner.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    });
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, '1');
    banner?.classList.add('opacity-0', 'translate-y-4');
    setTimeout(() => banner?.remove(), 500);
  });
</script>
