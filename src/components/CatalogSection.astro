---
import { catalog } from '../data/catalog';
import { getLangFromUrl, getLangPrefix } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as 'ru' | 'en';
const content = catalog[lang];
const prefix = getLangPrefix(lang);
---

<section class="max-w-7xl mx-auto px-6 py-20">
  <h1 class="text-3xl sm:text-4xl md:text-5xl font-black mb-4 tracking-tight font-mono">
    <span class="text-accent">import</span> {content.title.toLowerCase()}
  </h1>
  <p class="text-textMuted mb-12 font-mono">// {content.subtitle}</p>

  <div class="flex flex-col md:flex-row gap-8">
    <aside class="w-full md:w-64 shrink-0">
      <div class="bg-card rounded-3xl p-6 border border-white/5 sticky top-28">
        <h2 class="font-bold mb-6 flex items-center gap-2 font-mono text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
          {content.filtersLabel}
        </h2>

        <div class="space-y-2">
          <p class="text-xs font-bold text-textMuted uppercase mb-4">{content.categoryLabel}</p>
          {content.filters.map((filter, i) => (
            <button 
              class:list={[
                "filter-btn w-full text-left px-4 py-2 rounded-xl transition-all font-mono text-sm",
                i === 0 ? "bg-accent/10 text-accent border border-accent/20" : "text-textMuted hover:bg-white/5"
              ]}
              data-filter={filter}
            >
              {filter}
            </button>
          ))}
        </div>
      </div>
    </aside>

    <div class="flex-1 grid grid-cols-1 lg:grid-cols-3 gap-6">
      {content.products.map((product) => (
        <article 
          class="product-card bg-[#0f0f0f] rounded-[2rem] p-5 border border-white/5 flex flex-col group hover:border-white/10 transition-all"
          data-category={product.category}
        >
          {/* Изображение/Обложка */}
          <div class="aspect-square bg-[#1a1a1a] rounded-2xl mb-6 flex items-center justify-center relative overflow-hidden border border-white/5">
            <div class="absolute top-3 left-3 px-3 py-1 bg-black/50 backdrop-blur-md rounded-full text-[10px] font-bold text-white/70 border border-white/10 z-10">
              {content.productBadge}
            </div>
            
            {product.image ? (
              <img 
                src={product.image} 
                alt={product.name}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white/10"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            )}
            
            <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/40"></div>
          </div>
          <div class="flex flex-col flex-1">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold tracking-tight text-white">{product.name}</h3>
              <span class="px-2 py-1 bg-white/5 rounded-md text-[10px] text-textMuted border border-white/5">
                {product.category}
              </span>
            </div>
            
            <p class="text-textMuted text-xs mb-6 line-clamp-2 leading-relaxed">
              {product.desc}
            </p>

            <div class="mt-auto pt-4 border-t border-white/5">
              <p class="text-[10px] uppercase font-bold text-textMuted mb-1 tracking-widest">{content.priceLabel}</p>
              <div class="flex justify-between items-center">
                <span class="text-xl font-black text-[#7c061a]">{product.price}</span>
                <a 
                  href={`${prefix}/order?product=${encodeURIComponent(product.name)}`}
                  class="p-2 bg-white/5 hover:bg-white/10 rounded-xl transition-all border border-white/5"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>  </div>
</section>
<script>
  function initCatalog() {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.product-card');
    const allFilter = buttons[0]?.getAttribute('data-filter');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        
        buttons.forEach(b => {
          b.classList.remove('bg-accent/10', 'text-accent', 'border', 'border-accent/20');
          b.classList.add('hover:bg-white/5', 'text-textMuted');
        });
        btn.classList.add('bg-accent/10', 'text-accent', 'border', 'border-accent/20');
        btn.classList.remove('hover:bg-white/5', 'text-textMuted');

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === allFilter || category === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  initCatalog();
  document.addEventListener('astro:after-swap', initCatalog);
</script>
