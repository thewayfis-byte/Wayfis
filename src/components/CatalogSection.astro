---
import { catalog } from '../data/catalog';
import { getLangFromUrl, getLangPrefix } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as 'ru' | 'en';
const content = catalog[lang];
const prefix = getLangPrefix(lang);
const activeFilter = content.filters[0];
---

<section class="max-w-7xl mx-auto px-6">
  <h1 class="text-3xl sm:text-4xl md:text-5xl font-black mb-4 tracking-tight font-mono">
    <span class="text-accent">import</span> {content.title.toLowerCase()}
  </h1>
  <p class="text-textMuted mb-12 font-mono">// {content.subtitle}</p>

  <div class="flex flex-col md:flex-row gap-8">
    <aside class="w-full md:w-64 shrink-0">
      <div class="bg-card rounded-3xl p-6 border border-white/5 sticky top-28">
        <h2 class="font-bold mb-6 flex items-center gap-2 font-mono text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
          {content.filtersLabel}
        </h2>

        <div class="space-y-2">
          <p class="text-xs font-bold text-textMuted uppercase mb-4">{content.categoryLabel}</p>
          {content.filters.map((filter) => (
            <button class={`w-full text-left px-4 py-2.5 rounded-xl text-sm transition-all font-mono ${filter === activeFilter ? 'bg-accent/10 text-accent border border-accent/20' : 'hover:bg-white/5 text-textMuted'}`}>
              {filter}
            </button>
          ))}
        </div>
      </div>
    </aside>

    <div class="flex-1 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 reveal-stagger">
      {content.products.map((product) => (
        <article class="bg-card rounded-[2rem] p-6 border border-white/5 hover:border-accent/30 transition-all group font-mono card-hover-lift">
          <div class="aspect-square bg-gradient-to-br from-white/5 to-transparent rounded-2xl mb-6 flex items-center justify-center relative overflow-hidden">
            <div class="absolute top-4 left-4 px-3 py-1 bg-dark/50 backdrop-blur-md rounded-lg text-[10px] font-bold uppercase tracking-wider border border-white/5">
              {content.productBadge}
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white/10 group-hover:scale-110 transition-transform"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          </div>
          <div class="flex justify-between items-start gap-3 mb-2">
            <h3 class="font-bold text-lg text-white">{product.name}</h3>
            <span class="text-[10px] px-2 py-1 bg-white/5 rounded text-textMuted shrink-0">{product.category}</span>
          </div>
          <p class="text-textMuted text-sm mb-6 line-clamp-2">{product.desc}</p>
          <div class="flex justify-between items-center pt-4 border-t border-white/5">
            <div>
              <p class="text-[10px] text-textMuted uppercase font-bold">{content.priceLabel}</p>
              <p class="text-accent font-bold">{product.price}</p>
            </div>
            <a href={`${prefix}/#contact`} class="p-3 bg-accent/10 text-accent rounded-xl hover:bg-accent hover:text-white transition-all" aria-label={lang === 'ru' ? 'Заказать' : 'Order'}>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
